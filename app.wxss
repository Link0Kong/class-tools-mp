/* app.wxss —— 班级工具 v3 · Material 3 / Material You 设计系统
 * 全部 token 手写，无第三方 UI 库、无 CDN、无外部字体。
 * 单位换算：1dp = 2rpx（750 设计宽），故 M3 的 56dp = 112rpx。
 */

/* ===================== M3 TOKENS · LIGHT (BEGIN) ===================== */
page {
  /* —— 色彩角色（种子色 #5E8F87 = 站点主色）—— */
  --md-primary: #5E8F87;
  --md-on-primary: #FFFFFF;
  --md-primary-container: #D9EAE3;
  --md-on-primary-container: #173B34;

  --md-secondary: #7D9EBB;
  --md-on-secondary: #FFFFFF;
  --md-secondary-container: #DCE8F2;
  --md-on-secondary-container: #1C3142;

  --md-tertiary: #C6A475;
  --md-on-tertiary: #FFFFFF;
  --md-tertiary-container: #F3E7D3;
  --md-on-tertiary-container: #3D2B12;

  --md-surface: #F4F0E6;
  --md-surface-container-lowest: #FFFFFF;
  --md-surface-container-low: #F7F3EA;
  --md-surface-container: #EFE9DC;
  --md-surface-container-high: #E8E1D2;
  --md-surface-container-highest: #E0D9C9;

  --md-on-surface: #303A35;
  --md-on-surface-variant: #5C6860;
  --md-outline: #8B948B;
  --md-outline-variant: #E7DED0;

  --md-error: #B87870;
  --md-error-container: #F7E3DF;
  --md-on-error-container: #3E1713;
  --md-on-error: #FFFFFF;

  /* —— 按压态叠色（touchable 组件默认值；暗色下需要浅色才看得见）—— */
  --md-press-overlay: rgba(0, 0, 0, .05);

  /* —— 形状（M3 shape scale，rpx）—— */
  --md-shape-xs: 8rpx;
  --md-shape-sm: 16rpx;
  --md-shape-md: 24rpx;
  --md-shape-lg: 32rpx;
  --md-shape-xl: 56rpx;
  --md-shape-full: 999rpx;

  /* —— 高度（用 tonal + 弱阴影，不做重投影）—— */
  --md-elev-1: 0 2rpx 6rpx rgba(0, 0, 0, .06);
  --md-elev-2: 0 4rpx 14rpx rgba(0, 0, 0, .09);
  --md-elev-3: 0 10rpx 28rpx rgba(0, 0, 0, .12);

  /* —— 间距（4rpx 基准 / 页面安全边距 32rpx）—— */
  --md-space-1: 4rpx;
  --md-space-2: 8rpx;
  --md-space-3: 12rpx;
  --md-space-4: 16rpx;
  --md-space-5: 24rpx;
  --md-space-6: 32rpx;
  --md-space-7: 48rpx;
  /* 鸿蒙间隔参数（2026-11-19）：手机屏幕边距 16vp=32rpx；卡片间 12vp=24rpx；
     元素间大 16vp=32rpx / 普通 8vp=16rpx；主次文本纵 2vp=4rpx / 横 8vp=16rpx。 */
  --md-page-pad: 32rpx;
  --md-gap-card: 24rpx;
  --md-gap-elem-lg: 32rpx;
  --md-gap-elem: 16rpx;
  --md-gap-text: 4rpx;
  --md-gap-text-h: 16rpx;
  --md-list-min-h: 112rpx;

  /* —— 动效（M3 motion）—— */
  --md-ease-standard: cubic-bezier(0.2, 0, 0, 1);
  --md-ease-emphasized: cubic-bezier(0.05, 0.7, 0.1, 1);
  --md-dur-short: 200ms;
  --md-dur-medium: 300ms;

  background: var(--md-surface);
  color: var(--md-on-surface);
  color-scheme: light dark;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}
/* ===================== M3 TOKENS · LIGHT (END) ===================== */

/* ===================== M3 TOKENS · DARK (BEGIN) ===================== */
@media (prefers-color-scheme: dark) {
  page {
    --md-primary: #9BC9BB;
    --md-on-primary: #12332C;
    --md-primary-container: #2E5147;
    --md-on-primary-container: #D9EAE3;

    --md-secondary: #AAC6D8;
    --md-on-secondary: #1C3445;
    --md-secondary-container: #3A4E5C;
    --md-on-secondary-container: #DCE8F2;

    --md-tertiary: #E5C79B;
    --md-on-tertiary: #3D2B12;
    --md-tertiary-container: #5A4226;
    --md-on-tertiary-container: #F3E7D3;

    --md-surface: #1B1E1A;
    --md-surface-container-lowest: #161914;
    --md-surface-container-low: #22261F;
    --md-surface-container: #282C25;
    --md-surface-container-high: #333830;
    --md-surface-container-highest: #3E443B;

    --md-on-surface: #EDE8DC;
    --md-on-surface-variant: #C8C2B5;
    --md-outline: #8F958A;
    --md-outline-variant: #4A5046;

    --md-error: #F0B4AA;
    --md-error-container: #8A2E28;
    --md-on-error-container: #F7DAD4;
    --md-on-error: #42120E;
    --md-press-overlay: rgba(255, 255, 255, .10);

    --md-elev-1: 0 2rpx 6rpx rgba(0, 0, 0, .40);
    --md-elev-2: 0 4rpx 14rpx rgba(0, 0, 0, .50);
    --md-elev-3: 0 10rpx 28rpx rgba(0, 0, 0, .60);
  }
}
/* ===================== M3 TOKENS · DARK (END) ===================== */

/* ===================== 排版 · M3 type scale ===================== */
.t-display-s   { font-size: 72rpx; font-weight: 600; line-height: 1.15; letter-spacing: -0.5rpx; }
.t-headline-l  { font-size: 60rpx; font-weight: 600; line-height: 1.20; }
.t-headline-m  { font-size: 50rpx; font-weight: 600; line-height: 1.25; }
.t-title-l     { font-size: 42rpx; font-weight: 600; line-height: 1.30; }
.t-title-m     { font-size: 34rpx; font-weight: 600; line-height: 1.35; }
.t-body-l      { font-size: 32rpx; font-weight: 400; line-height: 1.5; }
.t-body-m      { font-size: 28rpx; font-weight: 400; line-height: 1.5; }
.t-label-l     { font-size: 28rpx; font-weight: 500; line-height: 1.4; }
.t-label-m     { font-size: 24rpx; font-weight: 500; line-height: 1.4; }
.t-num         { font-variant-numeric: tabular-nums; }
.muted         { color: var(--md-on-surface-variant); }
.strong        { color: var(--md-on-surface); font-weight: 600; }
.center        { text-align: center; }

/* ===================== 形状 / 高度 ===================== */
.r-xs   { border-radius: var(--md-shape-xs); }
.r-sm   { border-radius: var(--md-shape-sm); }
.r-md   { border-radius: var(--md-shape-md); }
.r-lg   { border-radius: var(--md-shape-lg); }
.r-xl   { border-radius: var(--md-shape-xl); }
.r-full { border-radius: var(--md-shape-full); }
.e0 { box-shadow: none; }
.e1 { box-shadow: var(--md-elev-1); }
.e2 { box-shadow: var(--md-elev-2); }
.e3 { box-shadow: var(--md-elev-3); }

/* ===================== 栅格 / 布局 ===================== */
.page      { min-height: 100vh; padding: 0 var(--md-page-pad); box-sizing: border-box; background: var(--md-surface); }
.pad-b     { padding-bottom: 200rpx; }
.stack > .stack-item { margin-bottom: var(--md-space-6); }
.stack-sm > .stack-item { margin-bottom: var(--md-space-4); }
.row       { display: flex; flex-direction: row; align-items: center; }
.row.wrap  { flex-wrap: wrap; gap: 8rpx; }
.row-top   { display: flex; flex-direction: row; align-items: flex-start; }
.col       { display: flex; flex-direction: column; }
.between   { justify-content: space-between; }
.grow      { flex: 1; min-width: 0; }
.wrap      { flex-wrap: wrap; }
.hidden    { display: none; }
.ellipsis  { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.divider   { height: 1rpx; background: var(--md-outline-variant); margin: var(--md-space-4) 0; }
.section-gap { height: var(--md-space-6); }
.sec-title { padding: var(--md-gap-elem-lg) 0 var(--md-gap-elem); }

/* ===================== 页面进入动效（级联） ===================== */
@keyframes mdEnter {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.enter { animation: mdEnter var(--md-dur-medium) var(--md-ease-emphasized) both; }
.enter-1 { animation-delay: 30ms; }
.enter-2 { animation-delay: 60ms; }
.enter-3 { animation-delay: 90ms; }
.enter-4 { animation-delay: 120ms; }
.enter-5 { animation-delay: 150ms; }
.enter-6 { animation-delay: 180ms; }

@keyframes mdSheetUp {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
@keyframes mdFade {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* ===================== 骨架屏（shimmer 扫光） ===================== */
.sk { background: var(--md-surface-container-high); border-radius: var(--md-shape-sm); overflow: hidden; position: relative; }
.sk-line { height: 28rpx; margin-bottom: var(--md-space-3); }
.sk-title { height: 42rpx; width: 40%; margin-bottom: var(--md-space-4); }
.sk-card { height: 180rpx; border-radius: var(--md-shape-lg); margin-bottom: var(--md-space-5); }
.sk-shimmer::after {
  content: "";
  position: absolute; top: 0; left: -60%; width: 60%; height: 100%;
  background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,.55) 50%, rgba(255,255,255,0) 100%);
  animation: mdShimmer 1.2s var(--md-ease-standard) infinite;
}
@keyframes mdShimmer { from { left: -60%; } to { left: 110%; } }

/* ===================== 按钮（Filled / Tonal / Outlined / Text） ===================== */
.m3-btn {
  display: inline-flex; align-items: center; justify-content: center;
  height: 96rpx; padding: 0 var(--md-gap-elem-lg); box-sizing: border-box;
  border-radius: var(--md-shape-full); border: none;
  font-size: 28rpx; font-weight: 500; line-height: 1;
  position: relative; overflow: hidden;
  transition: box-shadow var(--md-dur-short) var(--md-ease-standard), opacity var(--md-dur-short) var(--md-ease-standard);
}
.m3-btn--filled   { background: var(--md-primary); color: var(--md-on-primary); box-shadow: var(--md-elev-1); }
.m3-btn--tonal    { background: var(--md-secondary-container); color: var(--md-on-secondary-container); }
.m3-btn--outlined { background: transparent; color: var(--md-primary); border: 2rpx solid var(--md-outline); }
.m3-btn--text     { background: transparent; color: var(--md-primary); padding: 0 var(--md-gap-elem); }
.m3-btn--error    { background: var(--md-error); color: var(--md-on-error); }
.m3-btn--block    { display: flex; width: 100%; }
.m3-btn--sm       { height: 72rpx; padding: 0 32rpx; font-size: 26rpx; }
.m3-btn--disabled { opacity: .38; }
.m3-btn--gap      { margin-right: var(--md-gap-elem); }

/* ===================== 芯片（Chip / FilterChip） ===================== */
.m3-chip {
  display: inline-flex; align-items: center; height: 64rpx; padding: 0 var(--md-gap-elem-lg);
  margin: 0 var(--md-gap-elem) var(--md-gap-elem) 0;
  border-radius: var(--md-shape-full);
  border: 2rpx solid var(--md-outline-variant);
  background: transparent; color: var(--md-on-surface-variant);
  font-size: 26rpx; font-weight: 500;
  transition: background var(--md-dur-short) var(--md-ease-standard), color var(--md-dur-short) var(--md-ease-standard);
}
.m3-chip--selected { background: var(--md-secondary-container); color: var(--md-on-secondary-container); border-color: transparent; }
.m3-chip--assist   { background: var(--md-surface-container-high); border-color: transparent; color: var(--md-on-surface); }
.m3-chip__dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--md-primary); margin-right: var(--md-space-2); }
.chip-scroll { white-space: nowrap; }

/* ===================== 卡片（elevated / filled / outlined） ===================== */
.m3-card {
  background: var(--md-surface-container-low); color: var(--md-on-surface);
  border-radius: var(--md-shape-lg); padding: var(--md-space-6); box-sizing: border-box;
  margin-bottom: var(--md-gap-card);
  transition: box-shadow var(--md-dur-short) var(--md-ease-standard);
}
.m3-card--xl       { border-radius: var(--md-shape-xl); }
.m3-card--elevated { background: var(--md-surface-container-low); box-shadow: var(--md-elev-1); }
.m3-card--filled   { background: var(--md-surface-container-high); }
.m3-card--outlined { background: var(--md-surface); border: 2rpx solid var(--md-outline-variant); }
.m3-card--primary  { background: var(--md-primary-container); color: var(--md-on-primary-container); }
.m3-card--hero     { background: var(--md-primary-container); color: var(--md-on-primary-container); border-radius: var(--md-shape-xl); padding: var(--md-space-6); }
.m3-card__head     { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: var(--md-gap-elem); }

/* ===================== 列表项（ListItem：leading tonal 圆 + 标题/副标 + chevron） ===================== */
.m3-li {
  display: flex; flex-direction: row; align-items: center;
  min-height: var(--md-list-min-h); padding: var(--md-gap-elem) var(--md-gap-elem);
  border-radius: var(--md-shape-md); background: transparent;
  transition: background var(--md-dur-short) var(--md-ease-standard);
}
.m3-li--card { background: var(--md-surface-container-low); margin-bottom: var(--md-gap-card); }
.m3-li__lead {
  width: 76rpx; height: 76rpx; border-radius: var(--md-shape-full);
  background: #7D9EBB; color: #FFFFFF;
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; margin-right: var(--md-gap-elem); flex: none;
}
.m3-li__lead--primary   { background: #5E8F87; color: #FFFFFF; }
.m3-li__lead--tertiary  { background: #C6A475; color: #FFFFFF; }
.m3-li__body { flex: 1; min-width: 0; }
.m3-li__title { font-size: 32rpx; font-weight: 500; color: var(--md-on-surface); }
.m3-li__sub   { font-size: 26rpx; color: var(--md-on-surface-variant); margin-top: var(--md-gap-text); }
.m3-li__trail { color: var(--md-on-surface-variant); font-size: 32rpx; margin-left: var(--md-gap-elem); }
.chev::after { content: "›"; font-size: 40rpx; color: var(--md-on-surface-variant); line-height: 1; }

/* ===================== 表单（.field 版式） ===================== */
.field { display: flex; flex-direction: column; margin-bottom: var(--md-space-5); }
.field__label { font-size: 26rpx; font-weight: 500; color: var(--md-on-surface-variant); margin-bottom: var(--md-space-2); }
.field__hint  { font-size: 24rpx; color: var(--md-on-surface-variant); margin-top: var(--md-space-2); }
.field__ctrl {
  min-height: 96rpx; padding: 0 var(--md-space-5); box-sizing: border-box;
  background: var(--md-surface-container-high);
  border-radius: var(--md-shape-sm) var(--md-shape-sm) var(--md-shape-xs) var(--md-shape-xs);
  display: flex; flex-direction: row; align-items: center;
  font-size: 30rpx; color: var(--md-on-surface);
}
.field__input { flex: 1; min-width: 0; height: 96rpx; font-size: 30rpx; color: var(--md-on-surface); }
.field__ctrl--area { min-height: 200rpx; padding: var(--md-space-4) var(--md-space-5); align-items: flex-start; }
.field__text { flex: 1; font-size: 30rpx; }
.field__picker { flex: 1; font-size: 30rpx; color: var(--md-on-surface); }
.field--row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; min-height: var(--md-list-min-h); }
.field__row-divider { border-bottom: 1rpx solid var(--md-outline-variant); }
.slider { margin: 0; }
.switch-wrap { display: flex; align-items: center; }

/* ===================== FAB / 底部操作条 ===================== */
.fab {
  position: fixed; right: var(--md-page-pad); bottom: 48rpx;
  min-width: 112rpx; height: 112rpx; padding: 0 28rpx; box-sizing: border-box;
  border-radius: var(--md-shape-lg);
  background: var(--md-primary-container); color: var(--md-on-primary-container);
  display: flex; flex-direction: row; align-items: center; justify-content: center;
  box-shadow: var(--md-elev-2); z-index: 20;
  font-size: 28rpx; font-weight: 600;
  transition: transform var(--md-dur-short) var(--md-ease-emphasized);
}
.fab--extended { min-width: 260rpx; }
.fab--primary { background: var(--md-primary); color: var(--md-on-primary); }
.fab__icon { font-size: 42rpx; line-height: 1; }
.fab__label { margin-left: var(--md-space-3); }
.fab-spacer { height: 200rpx; }

.actionbar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
  padding: var(--md-space-4) var(--md-page-pad) calc(var(--md-space-4) + env(safe-area-inset-bottom));
  background: var(--md-surface-container-low);
  border-top: 1rpx solid var(--md-outline-variant);
  box-shadow: var(--md-elev-2);
}
.actionbar__inner { display: flex; flex-direction: row; align-items: center; gap: 12rpx; }

/* ===================== 顶栏（大标题，可收缩） ===================== */
/* 不加过渡：标题栏收缩会改变内容高度，动画期间 scrollTop 往返会把收缩来回触发（“持续抽动”）。 */
.appbar {
  position: sticky; top: 0; z-index: 15;
  padding: var(--md-space-6) 0 var(--md-space-3);
  background: var(--md-surface);
}
.appbar__title { font-size: 60rpx; font-weight: 600; line-height: 1.2; }
.appbar__sub   { font-size: 28rpx; color: var(--md-on-surface-variant); margin-top: var(--md-space-2); }
.appbar--collapsed { padding: var(--md-space-3) 0 var(--md-space-3); }
.appbar--collapsed .appbar__title { font-size: 40rpx; }
.appbar--collapsed .appbar__sub { display: none; }

/* ===================== 统计块 / 徽章 / 进度条 ===================== */
.stat {
  flex: 1; background: var(--md-surface-container-low); border-radius: var(--md-shape-lg);
  padding: var(--md-space-5); box-sizing: border-box;
}
.stat__value { font-size: 56rpx; font-weight: 600; color: var(--md-primary); line-height: 1.1; }
.stat__unit  { font-size: 24rpx; color: var(--md-on-surface-variant); margin-left: 6rpx; }
.stat__label { font-size: 24rpx; color: var(--md-on-surface-variant); margin-top: var(--md-space-2); }

.badge { display: inline-flex; align-items: center; height: 72rpx; padding: 0 36rpx; border-radius: var(--md-shape-full); font-size: 36rpx; font-weight: 600; }
.badge--primary   { background: var(--md-primary-container); color: var(--md-on-primary-container); }
.badge--tertiary  { background: var(--md-tertiary-container); color: var(--md-on-tertiary-container); }
.badge--error     { background: var(--md-error-container); color: var(--md-on-error-container); }

.progress { height: 16rpx; border-radius: var(--md-shape-full); background: var(--md-surface-container-highest); overflow: hidden; }
.progress__bar { height: 100%; border-radius: var(--md-shape-full); background: var(--md-primary); transition: width var(--md-dur-medium) var(--md-ease-standard); }
.progress--tertiary .progress__bar { background: var(--md-tertiary); }

/* ===================== 段控（SegmentedButton 兜底样式，主实现见 components/segmented） ===================== */
.m3-seg { display: flex; flex-direction: row; background: var(--md-surface-container-high); border-radius: var(--md-shape-full); padding: 4rpx; }

/* ===================== 触感层（ripple 用，主实现见 components/touchable） ===================== */
.ripple-host { position: relative; overflow: hidden; }
.ripple {
  position: absolute; border-radius: 50%; pointer-events: none;
  background: currentColor; opacity: .18; transform: scale(0);
  animation: mdRipple 420ms var(--md-ease-standard) forwards;
}
@keyframes mdRipple { to { transform: scale(1); opacity: 0; } }
/* 需求 13：按钮反馈统一为克制的 .32s（原 420ms 偏慢） */
.ripple { animation-duration: 320ms; }

/* ===================== 弹层（BottomSheet 兜底样式） ===================== */
.sheet-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0,0,0,.38); z-index: 100; animation: mdFade var(--md-dur-short) var(--md-ease-standard); }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 101;
  background: var(--md-surface-container-low);
  border-radius: var(--md-shape-xl) var(--md-shape-xl) 0 0;
  padding: var(--md-space-5) var(--md-page-pad) calc(var(--md-space-6) + env(safe-area-inset-bottom));
  animation: mdSheetUp var(--md-dur-medium) var(--md-ease-emphasized);
}
.sheet__grabber { width: 64rpx; height: 8rpx; border-radius: var(--md-shape-full); background: var(--md-outline-variant); margin: 0 auto var(--md-space-4); }

/* ===================== 空态 / 错误态 ===================== */
.empty-v2 { padding: var(--md-space-7) 0; display: flex; flex-direction: column; align-items: center; }
.empty-v2__art {
  width: 220rpx; height: 220rpx; border-radius: var(--md-shape-full);
  background: var(--md-surface-container-high); color: var(--md-on-surface-variant);
  display: flex; align-items: center; justify-content: center; font-size: 88rpx;
  margin-bottom: var(--md-space-5);
}
.empty-v2__title { font-size: 34rpx; font-weight: 600; color: var(--md-on-surface); }
.empty-v2__text  { font-size: 28rpx; color: var(--md-on-surface-variant); margin: var(--md-space-2) 0 var(--md-space-5); text-align: center; line-height: 1.5; }

/* ===================== 杂项 ===================== */
.pill  { display: inline-flex; align-items: center; height: 56rpx; padding: 0 24rpx; border-radius: var(--md-shape-full); font-size: 24rpx; font-weight: 500; }
.pill--primary  { background: var(--md-primary-container); color: var(--md-on-primary-container); }
.pill--neutral  { background: var(--md-surface-container-high); color: var(--md-on-surface-variant); }
.pill--tertiary { background: var(--md-tertiary-container); color: var(--md-on-tertiary-container); }
.pill--error    { background: var(--md-error-container); color: var(--md-on-error-container); }
.time-cd { font-size: 44rpx; font-weight: 600; color: var(--md-on-primary-container); }
.footer-note { padding: var(--md-space-6) 0; text-align: center; font-size: 24rpx; color: var(--md-on-surface-variant); }

/* ===================== 附件（作业 / 通知） ===================== */
.att-row { display: flex; flex-direction: row; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.att-thumb { width: 120rpx; height: 120rpx; border-radius: 12rpx; background: var(--md-surface-container-high); }
.att-chip { max-width: 360rpx; padding: 10rpx 16rpx; border-radius: 12rpx; background: var(--md-surface-container-high);
  color: var(--md-on-surface); font-size: 24rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.att-edit { position: relative; }
.att-x { position: absolute; top: -10rpx; right: -10rpx; width: 36rpx; height: 36rpx; line-height: 32rpx; text-align: center;
  border-radius: 999rpx; background: var(--md-error); color: var(--md-on-error, #fff); font-size: 26rpx; }

/* 固定底部操作条页面：预留操作条高度，避免最后一个按钮被挡住 */
.pad-action { padding-bottom: 360rpx; padding-bottom: calc(360rpx + env(safe-area-inset-bottom)); }

/* ===================== 暗色模式补充（token 之外的少量映射；跟随「外观」生效主题） =====================
   2026-11-15：不再用 @media —— 手动外观（显式浅色 + 系统深色 / 显式深色 + 系统浅色）时也要正确。
   .theme-dark 由 utils/appearance.js 注入每个页面根节点（系统模式时=系统主题）。 */
/* 工具图标底色：浅色模式是品牌中彩圆，暗色模式改成深色容器（白图标依旧清晰） */
.theme-dark .m3-li__lead { background: var(--md-secondary-container); }
.theme-dark .m3-li__lead--primary { background: var(--md-primary-container); }
.theme-dark .m3-li__lead--tertiary { background: var(--md-tertiary-container); }

/* 骨架屏扫光：暗色下白色高光过亮 */
.theme-dark .sk-shimmer::after {
  background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,.10) 50%, rgba(255,255,255,0) 100%);
}

/* 输入框 placeholder：仅暗色覆盖（浅色保持系统默认，不改原观感） */
.theme-dark .ph { color: var(--md-on-surface-variant); }

/* 使用说明 mint hero（2026-11-15 深色 hero 中性化）：与投票详情/抽签记录/体测 hero 同口径，
   深色下大面积品牌绿改中性面板，绿色只留图标/装饰小面积；浅色不变。 */
.theme-dark .ug-tone-mint { --ug-hbg: var(--md-surface-container-high); }


/* ===================== 名单气泡（1.4.2 名单选择：M3 简约 chip 语言） ===================== */
/* 选择器内气泡 + 页面已选摘要共用；只使用 M3 语义色 token，无渐变 / 高光 / 浮动 / 弹跳动画。
   未选 = surface-container-lowest 底 + outline-variant 细边 + on-surface 字；
   已选 = primary-container 底 + primary 边 + on-primary-container 字（M3 selected chip 语言）。
   交互只保留 hover-class 的轻微按压缩放（120ms），不再有果冻 / 圆角变形 / pop。 */
.lp-bubble {
  display: flex; flex-direction: row; align-items: center; justify-content: center;
  min-height: 92rpx; padding: 20rpx 22rpx; box-sizing: border-box;
  border-radius: var(--md-shape-full);
  background: var(--md-surface-container-lowest);
  border: 1rpx solid var(--md-outline-variant);
  color: var(--md-on-surface);
  font-size: 28rpx; font-weight: 600; line-height: 1.15;
  transition: transform 120ms var(--md-ease-standard), background 120ms var(--md-ease-standard),
              border-color 120ms var(--md-ease-standard), color 120ms var(--md-ease-standard);
}
.lp-bubble--sel {
  background: var(--md-primary-container);
  border-color: var(--md-primary);
  color: var(--md-on-primary-container);
}
.lp-bubble--press { transform: scale(.97); }
.lp-bubble__name { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.lp-bubble__seat {
  flex: none; margin-right: 8rpx;
  font-size: 20rpx; font-weight: 500; line-height: 1; opacity: .55;
  font-variant-numeric: tabular-nums;
}

/* 页面已选摘要：同款选中 chip 的小号版（静态，无动画） */
.lp-chip {
  display: inline-flex; align-items: center; max-width: 260rpx;
  padding: 8rpx 18rpx; margin: 0 12rpx 12rpx 0; box-sizing: border-box;
  border-radius: var(--md-shape-full);
  background: var(--md-primary-container);
  border: 1rpx solid var(--md-primary);
  color: var(--md-on-primary-container);
  font-size: 24rpx; font-weight: 600; line-height: 1.2;
}
.lp-chip__seat {
  flex: none; margin-right: 8rpx;
  font-size: 20rpx; font-weight: 500; line-height: 1; opacity: .55;
  font-variant-numeric: tabular-nums;
}
.lp-chip__name { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.lp-chip--more {
  background: transparent;
  border: 1rpx dashed var(--md-outline-variant);
  color: var(--md-on-surface-variant);
  font-weight: 500;
}

/* 5:4 分享卡离屏画布（分享弹层通用；页面级同名规则可覆盖） */
.share-canvas { position: fixed; left: -10000rpx; top: 0; width: 500px; height: 400px; pointer-events: none; }

/* ===================== v2.0.0 需求 13：全局动效统一 =====================
 * 统一节奏：进入/展开/弹层/切页 200–320ms；缓动 cubic-bezier(.2,.8,.3,1)（下方 --md-ease-emphasized 已是同类曲线）。
 * 动效只做装饰：不改变布局高度语义、不阻塞点击/滚动；列表滚动与卡片内容更新不触发整页动画。
 * 降级：系统开启「减少动效」时关闭所有装饰动画与过渡（功能与滚动完全不受影响）。
 * 说明：页面切换动画由微信原生转场负责（不额外包装，避免与手势返回冲突）。
 */
@media (prefers-reduced-motion: reduce) {
  .enter,
  .enter-1, .enter-2, .enter-3, .enter-4, .enter-5, .enter-6,
  .sheet-mask, .sheet { animation: none !important; }
  .sk-shimmer::after { animation: none !important; }
  .m3-btn, .m3-chip, .m3-li, .m3-card, .fab, .lp-bubble, .lp-chip, .progress__bar {
    transition: none !important;
  }
}

/* 鸿蒙间隔参数：折叠屏 / 平板屏幕左右边距（手机 16vp 已是默认 32rpx）。 */
@media (min-width: 600px) {
  page { --md-page-pad: 48rpx; }
}
@media (min-width: 900px) {
  page { --md-page-pad: 64rpx; }
}
