{
  "pages": [
    "pages/identity/identity",
    "pages/index/index",
    "pages/draw/draw",
    "pages/tt/tt",
    "pages/me/me",
    "pages/data/data",
    "pages/legal/legal",
    "pages/group/group",
    "pages/sum/sum",
    "pages/hw/hw",
    "pages/nt/nt",
    "pages/ft/ft",
    "pages/fttable/fttable",
    "pages/fb/fb",
    "pages/ug/ug",
    "pages/all/all",
    "pages/roll/roll",
    "pages/committee/committee",
    "pages/stats/stats",
    "pages/power/power",
    "pages/water/water",
    "pages/vote/vote",
    "pages/votedetail/votedetail",
    "pages/drawrec/drawrec"
  ],
  "subPackages": [
    {
      "root": "pages/ppt",
      "name": "ppt",
      "pages": [
        "ppt"
      ]
    },
    {
      "root": "pages/pptdl",
      "name": "pptdl",
      "pages": [
        "pptdl"
      ]
    },
    {
      "root": "pages/pptplay",
      "name": "pptplay",
      "pages": [
        "pptplay"
      ]
    },
    {
      "root": "pages/diag",
      "name": "diag",
      "pages": [
        "diag"
      ]
    },
    {
      "root": "pages/cloudspace",
      "name": "cloudspace",
      "pages": [
        "cloudspace"
      ]
    },
    {
      "root": "pages/screencast",
      "name": "screencast",
      "pages": [
        "screencast"
      ]
    },
    {
      "root": "pages/map",
      "name": "map",
      "pages": [
        "map"
      ]
    }
  ],
  "preloadRule": {
    "pages/all/all": {
      "network": "wifi",
      "packages": [
        "pages/ppt",
        "pages/pptdl",
        "pages/pptplay"
      ]
    }
  },
  "window": {
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTitleText": "班级工具",
    "navigationBarTextStyle": "@navTextStyle",
    "backgroundColor": "@bgColor",
    "backgroundTextStyle": "@bgTextStyle",
    "backgroundColorTop": "@bgColorTop",
    "backgroundColorBottom": "@bgColorBottom"
  },
  "tabBar": {
    "color": "@tabColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBgColor",
    "borderStyle": "@tabBorderStyle",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "工作台",
        "iconPath": "@tabWorkIcon",
        "selectedIconPath": "@tabWorkIconOn"
      },
      {
        "pagePath": "pages/all/all",
        "text": "工具",
        "iconPath": "@tabToolsIcon",
        "selectedIconPath": "@tabToolsIconOn"
      },
      {
        "pagePath": "pages/me/me",
        "text": "我的",
        "iconPath": "@tabMeIcon",
        "selectedIconPath": "@tabMeIconOn"
      }
    ]
  },
  "style": "v2",
  "darkmode": true,
  "themeLocation": "theme.json",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
