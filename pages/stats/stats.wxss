.page-head { padding: 40rpx 0 20rpx; }

/* 范围筛选：今天 / 近 7 天 两个 chip 等分（≥40px 点按区） */
.st-filters { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; margin-bottom: 16rpx; }
.st-fgroup { display: flex; flex-wrap: nowrap; align-items: center; gap: 10rpx; min-width: 0; }
.st-fgroup--range { flex: 1 1 auto; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
.st-chip {
  flex: 1 1 0; min-width: 0; height: auto; min-height: 80rpx;
  padding: 0 14rpx; margin: 0; box-sizing: border-box;
  display: inline-flex; align-items: center; justify-content: center;
  white-space: nowrap;
}

/* 摘要 4 格：窄屏 2×2，宽屏 1×4 */
.st-sum { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28rpx 16rpx; }
.st-sum__item { min-width: 0; }
.st-sum__value {
  font-size: 52rpx; font-weight: 600; line-height: 1.1; color: var(--md-primary);
  font-variant-numeric: tabular-nums;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.st-sum__label { margin-top: 4rpx; font-size: 24rpx; color: var(--md-on-surface-variant); white-space: nowrap; }
@media (min-width: 700px) {
  .st-sum { grid-template-columns: repeat(4, minmax(0, 1fr)); }
}

/* 趋势柱状图：今天 24 根 / 近 7 天 7 根，柱高由 render() 算好 */
.st-trend { display: flex; align-items: flex-end; gap: 4rpx; min-width: 0; }
.st-tb { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; align-items: center; }
.st-tb__num {
  height: 24rpx; line-height: 24rpx; font-size: 16rpx; color: var(--md-on-surface-variant);
  white-space: nowrap; font-variant-numeric: tabular-nums;
}
.st-tb__bar { width: 100%; height: 220rpx; display: flex; align-items: flex-end; }
.st-tb__fill { width: 100%; background: var(--md-primary); border-radius: 6rpx 6rpx 0 0; }
.st-tb__lb {
  height: 28rpx; line-height: 28rpx; font-size: 18rpx; color: var(--md-on-surface-variant);
  white-space: nowrap; font-variant-numeric: tabular-nums;
}
.st-tb--today .st-tb__fill { background: var(--md-tertiary); }
.st-tb--today .st-tb__lb { color: var(--md-tertiary); font-weight: 600; }

/* 登录端：一条堆叠条 + 图例 */
.st-stack {
  display: flex; height: 28rpx; margin-bottom: 20rpx;
  border-radius: 999rpx; overflow: hidden;
  background: var(--md-surface-container-high);
}
.st-stack__seg { height: 100%; }
.st-leg { display: flex; flex-wrap: wrap; gap: 12rpx 20rpx; }
.st-leg__row { flex: 1 1 44%; min-width: 0; display: flex; align-items: center; gap: 8rpx; }
.st-leg__dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex: none; }
.st-leg__name {
  flex: 1 1 auto; min-width: 0; font-size: 24rpx; color: var(--md-on-surface);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.st-leg__n { flex: none; font-size: 24rpx; color: var(--md-on-surface-variant); font-variant-numeric: tabular-nums; }
.st-leg__p {
  flex: none; width: 64rpx; text-align: right; font-size: 24rpx;
  color: var(--md-on-surface-variant); font-variant-numeric: tabular-nums;
}

/* 版本 / 设备：宽屏双栏，窄屏上下 */
.st-duo { display: flex; flex-wrap: wrap; gap: 24rpx; align-items: stretch; margin-bottom: var(--md-gap-card); }
.st-duo > .m3-card { flex: 1 1 300px; min-width: 0; margin-bottom: 0; }
.st-dist { margin-bottom: 20rpx; }
.st-dist:last-child { margin-bottom: 0; }
.st-dist__top { display: flex; align-items: baseline; gap: 12rpx; min-width: 0; }
.st-dist__label {
  flex: 0 1 auto; min-width: 0; font-size: 26rpx; color: var(--md-on-surface);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.st-dist__dev {
  flex: 1 1 auto; min-width: 0; font-size: 22rpx; color: var(--md-on-surface-variant);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.st-dist__n { flex: none; margin-left: auto; font-size: 24rpx; color: var(--md-on-surface); font-variant-numeric: tabular-nums; }
.st-dist__p { flex: none; width: 72rpx; text-align: right; font-size: 22rpx; color: var(--md-on-surface-variant); font-variant-numeric: tabular-nums; }
.st-dist__track {
  margin-top: 8rpx; height: 12rpx; border-radius: 999rpx;
  background: var(--md-surface-container-high); overflow: hidden;
}
.st-dist__fill { height: 100%; border-radius: 999rpx; background: var(--md-primary); }

/* 账号明细 */
.st-note { margin-bottom: 8rpx; font-size: 22rpx; color: var(--md-on-surface-variant); }
.st-acc { border-bottom: 1rpx solid var(--md-outline-variant); padding: 16rpx 0; }
.st-acc:last-child { border-bottom: none; padding-bottom: 0; }
.st-acc__main { display: flex; align-items: flex-start; gap: 16rpx; min-width: 0; min-height: 96rpx; box-sizing: border-box; }
.st-acc__main--hover { background: var(--md-press-overlay); border-radius: var(--md-shape-sm); }
.st-acc__badge {
  flex: none; width: 52rpx; height: 52rpx; border-radius: 50%;
  background: var(--md-surface-container-high); color: var(--md-on-surface-variant);
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 600; font-variant-numeric: tabular-nums;
}
.st-acc__badge.is-top { background: var(--md-primary); color: var(--md-on-primary); }
.st-acc__info { flex: 1 1 auto; min-width: 0; }
.st-acc__name {
  font-size: 30rpx; font-weight: 600; color: var(--md-on-surface);
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.st-acc__tags { display: flex; flex-wrap: wrap; gap: 6rpx; margin-top: 8rpx; min-width: 0; }
.st-tag {
  max-width: 100%; padding: 2rpx 12rpx; border-radius: 999rpx;
  background: var(--md-surface-container-high); color: var(--md-on-surface-variant);
  font-size: 20rpx; line-height: 1.7;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.st-tag--dev { max-width: 100%; }
.st-acc__right { flex: none; min-width: 88rpx; text-align: right; }
.st-acc__n { font-size: 32rpx; font-weight: 600; color: var(--md-primary); font-variant-numeric: tabular-nums; white-space: nowrap; }
.st-acc__unit { margin-left: 2rpx; font-size: 20rpx; font-weight: 400; color: var(--md-on-surface-variant); }
.st-acc__chev { margin-top: 2rpx; font-size: 20rpx; color: var(--md-on-surface-variant); }
.st-acc__bar { margin-top: 10rpx; height: 10rpx; border-radius: 999rpx; background: var(--md-surface-container-high); overflow: hidden; }
.st-acc__fill { height: 100%; border-radius: 999rpx; background: var(--md-primary); }
.st-detail {
  margin-top: 14rpx; padding: 18rpx 20rpx;
  border-radius: var(--md-shape-md); background: var(--md-surface-container-low);
}
.st-detail__line { font-size: 24rpx; line-height: 1.7; color: var(--md-on-surface-variant); word-break: break-word; }
.st-detail__k { margin-right: 8rpx; font-weight: 500; color: var(--md-on-surface); }
.st-dev {
  display: flex; flex-wrap: wrap; align-items: baseline; gap: 4rpx 12rpx;
  padding: 4rpx 0; font-size: 22rpx; color: var(--md-on-surface-variant);
}
.st-dev__name {
  flex: 1 1 auto; min-width: 0; color: var(--md-on-surface);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.st-dev__n, .st-dev__time { flex: none; font-variant-numeric: tabular-nums; }

/* —— 暗色：底槽跟随实际生效主题（.theme-dark 由 utils/appearance.js 注入） —— */
.theme-dark .st-stack,
.theme-dark .st-dist__track,
.theme-dark .st-acc__bar { background: rgba(255, 255, 255, .10); }
.theme-dark .st-detail { background: var(--md-surface-container); }
