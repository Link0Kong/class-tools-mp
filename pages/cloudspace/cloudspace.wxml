<!-- pages/cloudspace/cloudspace.wxml —— 文件传输 · 临时云空间 -->
<page-meta page-style="{{themeStyle}}"></page-meta>

<view class="cs-page {{themeClass}}">
  <view class="cs-head">
    <view class="cs-head-l">
      <view class="cs-title">临时云空间</view>
      <view class="cs-sub">同账号 · 跨设备 · 文件自上传起保留 3 天</view>
    </view>
    <view class="cs-refresh" hover-class="cs-hover" bindtap="onRefreshTap">刷新</view>
  </view>

  <view class="cs-stats">
    <view class="cs-stat">
      <view class="cs-stat-n">{{count}}</view>
      <view class="cs-stat-l">文件</view>
    </view>
    <view class="cs-stat">
      <view class="cs-stat-n">{{bytesText}}</view>
      <view class="cs-stat-l">已占用</view>
    </view>
    <view class="cs-stat">
      <view class="cs-stat-n">3 天</view>
      <view class="cs-stat-l">自动保留</view>
    </view>
  </view>

  <view class="cs-actions">
    <view class="cs-primary" hover-class="cs-hover" bindtap="chooseFiles">上传文件</view>
    <view class="cs-ghost" hover-class="cs-hover" bindtap="clearSpace">清空空间</view>
  </view>

  <view wx:if="{{err}}" class="cs-tip" bindtap="retry">{{err}} · 点此重试</view>

  <view wx:if="{{ups.length}}" class="cs-card">
    <view class="cs-card-h">上传进度<text class="cs-card-c">本次 {{ups.length}} 个</text></view>
    <view wx:for="{{ups}}" wx:key="id" class="cs-up">
      <view class="cs-up-top">
        <text class="cs-up-name">{{item.name}}</text>
        <text class="cs-up-pct">{{item.pct}}%</text>
      </view>
      <view class="cs-up-bar"><view class="cs-up-in" style="width:{{item.pct}}%"></view></view>
      <view class="cs-up-foot">{{item.sizeText}} · {{item.stateText}}</view>
    </view>
  </view>

  <view class="cs-card">
    <view class="cs-card-h">文件<text class="cs-card-c">{{loading ? '连接中…' : (count ? '共 ' + count + ' 个' : '')}}</text></view>
    <view wx:if="{{!files.length}}" class="cs-empty">{{loading ? '正在连接云空间…' : '还没有文件，点上方「上传文件」'}}</view>
    <block wx:for="{{files}}" wx:key="id">
      <view class="cs-file">
        <view class="cs-file-ico">{{item.ico}}</view>
        <view class="cs-file-main">
          <view class="cs-file-name">{{item.name}}</view>
          <view class="cs-file-meta"><text wx:if="{{converting[item.id] || item.conversionText}}"
            class="{{item.conversion.status === 'failed' ? 'cs-file-error' : ''}}">{{converting[item.id] ? '正在提交' : item.conversionText}} · </text>{{item.sizeText}} · {{item.timeText}} · {{item.ttlText}}</view>
        </view>
        <view class="cs-file-acts">
          <view class="cs-dl" hover-class="cs-hover" bindtap="download" data-id="{{item.id}}">{{item.opened ? '打开' : '下载'}}</view>
          <block wx:if="{{item.conversionAction}}">
            <view class="cs-dl cs-ppt-action" hover-class="cs-hover" bindtap="conversionAction"
                  data-id="{{item.id}}">{{item.conversionAction}}</view>
            <view class="cs-dl cs-ppt-more" hover-class="cs-hover" bindtap="conversionAction"
                  aria-label="{{item.conversionAction}}" data-id="{{item.id}}" data-more="{{true}}">···</view>
          </block>
          <view class="cs-del" hover-class="cs-hover" bindtap="del" data-id="{{item.id}}">删除</view>
        </view>
      </view>
    </block>
    <view wx:if="{{expired}}" class="cs-expired">{{expired}} 个文件已过期（上传超过 72 小时，已自动删除）</view>
  </view>

  <view class="cs-note">同账号的电脑 / 手机 / 大屏打开「文件传输」即可看到同一批文件；任意大小，自动分片上传。单个文件上传完成 72 小时后自动删除，也可单独删除或清空空间。正式版需在微信后台配置 request / downloadFile 合法域名（tool.furina.fun）。</view>
</view>
