.page-head { padding: 40rpx 0 20rpx; }
.sel-wrap { display: flex; flex-wrap: wrap; align-items: center; margin-top: 18rpx; }

/* 成员来源：三段按钮（≥96rpx=48px 点按区；与既有 m3 按钮高度规范一致） */
.src-row { display: flex; flex-direction: row; }
.src-btn {
  flex: 1; min-width: 0; min-height: 120rpx; padding: 14rpx 10rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  border-radius: var(--md-shape-md); background: var(--md-surface-container-high);
  color: var(--md-on-surface-variant); text-align: center;
}
.src-btn + .src-btn { margin-left: 12rpx; }
.src-btn--on { background: var(--md-secondary-container); color: var(--md-on-secondary-container); }
.src-btn--off { opacity: .48; }
.src-btn--tap { opacity: .72; }
.src-btn__t { font-size: 27rpx; font-weight: 600; line-height: 1.25; }
.src-btn__s { max-width: 100%; margin-top: 4rpx; font-size: 21rpx; line-height: 1.3;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* 分组方式：两段按钮（≥88rpx=44px） */
.seg { display: flex; flex-direction: row; }
.seg__btn {
  flex: 1; min-height: 88rpx; display: flex; align-items: center; justify-content: center;
  border-radius: var(--md-shape-full); background: var(--md-surface-container-high);
  color: var(--md-on-surface-variant); font-size: 28rpx; font-weight: 500;
}
.seg__btn + .seg__btn { margin-left: 12rpx; }
.seg__btn--on { background: var(--md-secondary-container); color: var(--md-on-secondary-container); font-weight: 600; }

/* 数字步进：− [输入] ＋（圆钮 96rpx=48px，满足点按区） */
.stepper { display: flex; flex-direction: row; align-items: center; }
.stepper__btn {
  width: 96rpx; height: 96rpx; flex: none;
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--md-shape-full); background: var(--md-surface-container-high);
  color: var(--md-primary); font-size: 44rpx; font-weight: 600;
}
.stepper__btn--tap { opacity: .66; }
.stepper__input {
  flex: 1; min-width: 0; height: 96rpx; margin: 0 12rpx; text-align: center;
  border-radius: var(--md-shape-sm); background: var(--md-surface-container-high);
  font-size: 36rpx; font-weight: 600; color: var(--md-on-surface);
}

.gcard { background: var(--md-surface-container-lowest); border-radius: var(--md-shape-lg); padding: 32rpx; margin-bottom: 24rpx; }
.gmembers { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 20rpx; }
.gmem { display: flex; flex-direction: row; align-items: center; background: var(--md-surface-container-high);
  border-radius: 999rpx; padding: 10rpx 24rpx; margin: 0 16rpx 16rpx 0; }
.gmem__n { font-size: 24rpx; font-weight: 600; color: var(--md-primary); margin-right: 12rpx; }
.gmem__name { font-size: 28rpx; color: var(--md-on-surface); }
.sum-line { font-size: 27rpx; font-weight: 600; color: var(--md-on-surface-variant); margin: 4rpx 0 20rpx; }
.exp-canvas { position: fixed; left: -10000rpx; top: 0; width: 750rpx; height: 2000rpx; pointer-events: none; }
/* 5:4 分享卡画布（离屏；分组结果变化后异步生成） */
.share-canvas { position: fixed; left: -10000rpx; top: 0; width: 500px; height: 400px; pointer-events: none; }
.share-btn {
  margin: 0 8rpx; padding: 0 24rpx; height: 64rpx; min-height: 64rpx; line-height: 64rpx;
  display: inline-flex; align-items: center; justify-content: center;
  border: 0; border-radius: var(--md-shape-full);
  background: var(--md-primary-container); color: var(--md-on-primary-container);
  font-size: 24rpx; font-weight: 600;
}
.share-btn::after { border: 0; }
.share-btn--tap { opacity: .72; }
