@import "../../styles/file-sections.wxss";
/* pages/ppt/ppt.wxss —— 「演示」列表页（暖白卡片 + 雾青主色；DESIGN §4.1–4.2）
 * 全部尺寸按 750 设计宽（1px = 2rpx）；卡片信息密度对齐设计稿：封面 128×72 → 256×144rpx。 */

.ppt-page { padding-top: 8rpx; }

/* ---------------- 顶部标题 + 上传按钮 ---------------- */
.ppt-head { display: flex; flex-direction: row; align-items: center; padding: 12rpx 0 20rpx; }
.ppt-head-t { font-size: 40rpx; font-weight: 600; line-height: 1.2; color: var(--md-on-surface); }
.ppt-upbtn {
  height: 72rpx; padding: 0 36rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--md-primary); color: var(--md-on-primary);
  font-size: 28rpx; font-weight: 500; box-shadow: var(--md-elev-1);
  transition: opacity var(--md-dur-short) var(--md-ease-standard);
}
.ppt-upbtn--tap { opacity: .88; }
.ppt-upbtn--off { opacity: .38; }

/* ---------------- 转换机心跳 ---------------- */
.ppt-hb {
  display: flex; flex-direction: row; align-items: center;
  padding: 14rpx 22rpx; margin-bottom: 16rpx; border-radius: 16rpx;
  background: var(--md-surface-container-low);
  font-size: 24rpx; color: var(--md-on-surface-variant);
}
.ppt-dot { width: 14rpx; height: 14rpx; border-radius: 50%; margin-right: 12rpx; flex: none; }
.ppt-dot--ok { background: #4E9082; }
.ppt-dot--off { background: #B98F63; }
.ppt-hb-t { flex: 1; min-width: 0; }
.ppt-hb-q { font-size: 22rpx; opacity: .8; margin-left: 12rpx; }

/* 轻提示（保留旧列表，不白屏） */
.ppt-tip {
  padding: 14rpx 22rpx; margin-bottom: 16rpx; border-radius: 16rpx;
  background: var(--md-error-container); color: var(--md-on-error-container);
  font-size: 24rpx;
}

/* ---------------- 卡片 ---------------- */
.ppt-list { display: flex; flex-direction: column; }
.ppt-card {
  display: flex; flex-direction: row; align-items: center;
  padding: 20rpx; margin-bottom: 16rpx; border-radius: 24rpx;
  background: var(--md-surface-container-lowest);
  box-shadow: var(--md-elev-1);
  transition: background var(--md-dur-short) var(--md-ease-standard);
}
.ppt-card--tap { background: var(--md-surface-container-low); }
.ppt-cover {
  position: relative; width: 256rpx; height: 144rpx; border-radius: 16rpx;
  overflow: hidden; flex: none;
  background: var(--md-surface-container);
  display: flex; align-items: center; justify-content: center;
}
.ppt-cover-img { width: 100%; height: 100%; display: block; }
.ppt-cover-ph { font-size: 56rpx; opacity: .35; }
/* v2.0 §12.4.1 下载中心：列表小标签「兼容版」「PDF」（不写长句） */
.ppt-tag {
  height: 40rpx; line-height: 40rpx; padding: 0 14rpx; margin-left: 10rpx;
  border-radius: 10rpx; font-size: 20rpx; font-weight: 500; flex: none;
}
.ppt-tag--compat { background: #E6F0ED; color: #356E63; }
.ppt-tag--pdf { background: #EEF1F4; color: #4C6479; }
.ppt-cover-up { position: absolute; left: 0; right: 0; bottom: 0; height: 6rpx; background: rgba(0, 0, 0, .16); }
.ppt-cover-up-bar { height: 100%; background: var(--md-primary); transition: width 200ms linear; }
.ppt-card-main { flex: 1; min-width: 0; margin-left: 20rpx; }
.ppt-title {
  font-size: 30rpx; font-weight: 600; line-height: 1.35; color: var(--md-on-surface);
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.ppt-meta {
  margin-top: 8rpx; font-size: 24rpx; color: var(--md-on-surface-variant);
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.ppt-sub {
  margin-top: 6rpx; font-size: 22rpx; line-height: 1.4; color: var(--md-error);
  overflow: hidden; text-overflow: ellipsis;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
}
.ppt-foot { margin-top: 10rpx; display: flex; flex-direction: row; align-items: center; min-height: 44rpx; }

/* 状态胶囊（高 22px → 44rpx；ready 不显示胶囊） */
.ppt-pill {
  height: 44rpx; line-height: 44rpx; padding: 0 18rpx; border-radius: 22rpx;
  font-size: 22rpx; font-weight: 500; flex: none;
}
.ppt-pill--primary { background: var(--md-primary-container); color: var(--md-on-primary-container); }
.ppt-pill--tertiary { background: var(--md-tertiary-container); color: var(--md-on-tertiary-container); }
.ppt-pill--error { background: var(--md-error-container); color: var(--md-on-error-container); }
.ppt-pill--ok { background: transparent; color: var(--md-primary); }
.ppt-pill--neutral { background: var(--md-surface-container-high); color: var(--md-on-surface-variant); }

.ppt-act {
  font-size: 24rpx; color: var(--md-primary); font-weight: 500;
  padding: 8rpx 16rpx; margin-left: 8rpx; border-radius: 12rpx;
}
.ppt-more {
  width: 48rpx; height: 48rpx; line-height: 40rpx; text-align: center;
  font-size: 34rpx; color: var(--md-on-surface-variant);
  border-radius: 24rpx; margin-left: 4rpx;
}
.ppt-more--tap { background: var(--md-surface-container-high); }

/* ---------------- 空态（不放插画） ---------------- */
.ppt-empty { padding: 140rpx 0 40rpx; display: flex; flex-direction: column; align-items: center; }
.ppt-empty-art {
  width: 200rpx; height: 200rpx; border-radius: 100rpx;
  background: var(--md-surface-container-high);
  display: flex; align-items: center; justify-content: center;
  font-size: 80rpx; margin-bottom: 32rpx;
}
.ppt-empty-t { font-size: 32rpx; font-weight: 600; color: var(--md-on-surface-variant); }
.ppt-empty-btn {
  margin-top: 28rpx; height: 80rpx; padding: 0 44rpx; border-radius: 40rpx;
  display: flex; align-items: center; justify-content: center;
  background: var(--md-primary); color: var(--md-on-primary);
  font-size: 28rpx; font-weight: 500;
}
.ppt-empty-btn--tap { opacity: .88; }
.ppt-empty-hint { margin-top: 16rpx; font-size: 24rpx; color: var(--md-on-surface-variant); }

/* ---------------- 上传进度条 ---------------- */
.ppt-up {
  position: fixed; left: var(--md-page-pad); right: var(--md-page-pad);
  bottom: calc(var(--md-space-6) + env(safe-area-inset-bottom));
  z-index: 40; padding: 22rpx 24rpx; border-radius: 24rpx;
  background: var(--md-surface-container-lowest);
  box-shadow: var(--md-elev-3);
}
.ppt-up-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
.ppt-up-title {
  flex: 1; min-width: 0; font-size: 26rpx; font-weight: 600; color: var(--md-on-surface);
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.ppt-up-pct { font-size: 24rpx; font-weight: 600; color: var(--md-primary); margin-left: 16rpx; }
.ppt-up-prog { margin: 14rpx 0 10rpx; }
.ppt-up-sub { font-size: 22rpx; color: var(--md-on-surface-variant); }
.ppt-up-cancel { font-size: 24rpx; color: var(--md-error); padding: 6rpx 12rpx; }

/* ---------------- 标题弹层 ---------------- */
.ppt-sheet { z-index: 101; }
.ppt-sheet-t { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; }
.ppt-sheet-btns { margin-top: 8rpx; display: flex; flex-direction: row; align-items: center; }

/* ---------------- 骨架屏 ---------------- */
.ppt-sk { display: flex; flex-direction: row; align-items: center; }
.ppt-sk-cover { width: 256rpx; height: 144rpx; border-radius: 16rpx; flex: none; }
.ppt-sk-body { flex: 1; margin-left: 20rpx; }
