.page-head { padding: 40rpx 0 20rpx; }
.cfg-toggle { display: flex; flex-direction: row; align-items: center; padding: 4rpx 0; }
.cfg-sub { margin-top: 6rpx; }
.cfg-action { flex: none; font-size: 26rpx; font-weight: 600; color: var(--md-primary); padding: 12rpx 8rpx 12rpx 24rpx; }
.cfg-row { display: flex; flex-direction: row; align-items: flex-start; justify-content: space-between; padding: 18rpx 0; border-top: 1rpx solid var(--md-outline-variant); }
.cfg-row:first-of-type { margin-top: 20rpx; }
.cfg-k { font-size: 26rpx; color: var(--md-on-surface-variant); margin-right: 24rpx; flex: none; }
.cfg-v { font-size: 28rpx; color: var(--md-on-surface); text-align: right; flex: 1; }
.res-card { padding: 28rpx 28rpx 20rpx; }
.res-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.res-chip { display: flex; flex-direction: row; align-items: baseline; gap: 10rpx; min-width: 0;
  padding: 14rpx 18rpx; border-radius: 16rpx; background: var(--md-surface-container-lowest);
  border: 2rpx solid var(--md-outline-variant); }
.res-n { flex: none; font-size: 30rpx; font-weight: 700; color: var(--md-primary); font-variant-numeric: tabular-nums; }
.res-nm { min-width: 0; font-size: 26rpx; color: var(--md-on-surface); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.exp-canvas { position: fixed; left: -10000rpx; top: 0; width: 750rpx; height: 2000rpx; pointer-events: none; }
