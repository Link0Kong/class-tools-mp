<page-meta page-style="{{themeStyle}}"></page-meta>

<view class="page pad-b pad-action {{themeClass}}">

  <view class="page-head">
    <view class="t-headline-m">结果单</view>
    <view class="t-body-m muted">第 3 步 · 抽签 + 分组汇总，可复制 / 分享</view>
  </view>

  <segmented items="{{steps}}" value="s3" bindchange="onStep" />

  <view class="section-gap"></view>

  <block wx:if="{{state === 'loading'}}">
    <view class="m3-card m3-card--filled enter enter-1">
      <view class="sk sk-title sk-shimmer"></view>
      <view class="sk sk-line sk-shimmer"></view>
      <view class="sk sk-line sk-shimmer" style="width:60%"></view>
    </view>
    <view class="m3-card m3-card--filled enter enter-2"><view class="sk sk-card sk-shimmer"></view></view>
  </block>

  <block wx:else>
    <view class="m3-card m3-card--outlined" wx:if="{{state === 'error'}}">
      <empty-state mode="error" icon="⚠" title="汇总失败" text="{{errorText}}" action-text="重试" bind:action="build"></empty-state>
    </view>

    <view class="m3-card m3-card--filled" wx:elif="{{state === 'empty'}}">
      <empty-state icon="📄" title="还没有可以汇总的内容" text="先完成抽签或分组再回来" action-text="去抽签" bind:action="goDraw"></empty-state>
    </view>

    <block wx:else>
      <!-- —— 参数配置（默认收起，避免挤占结果）—— -->
      <view class="m3-card m3-card--elevated enter enter-1">
        <view class="cfg-toggle" bindtap="toggleCfg">
          <view class="grow">
            <view class="t-title-m">参数配置</view>
            <view class="t-label-m muted cfg-sub">{{sub || '抽签 / 分组参数'}}</view>
          </view>
          <text class="cfg-action">{{showCfg ? '收起' : '展开'}}</text>
        </view>
        <block wx:if="{{showCfg}}">
          <view class="cfg-row" wx:for="{{cfg}}" wx:key="k">
            <text class="cfg-k">{{item.k}}</text>
            <text class="cfg-v">{{item.v || '–'}}</text>
          </view>
        </block>
      </view>

      <!-- —— 汇总块 —— -->
      <view class="m3-card m3-card--filled res-card enter enter-2" wx:for="{{viewBlocks}}" wx:key="index">
        <view class="m3-card__head">
          <view class="t-title-m">{{item.label}}</view>
        </view>
        <view class="res-grid">
          <view class="res-chip" wx:for="{{item.items}}" wx:for-item="r" wx:key="k">
            <text wx:if="{{r.n !== ''}}" class="res-n">{{r.n}}</text>
            <text wx:if="{{r.nm}}" class="res-nm">{{r.nm}}</text>
          </view>
        </view>
      </view>
    </block>
  </block>

  <canvas type="2d" id="card" class="exp-canvas"></canvas>
  <canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>

  <share-sheet show="{{shareSheet}}" preview="{{shareImg}}" preview-alt="{{sharePoster}}"
               title-text="{{shareTitle}}" busy="{{shareBusy}}" hint="{{shareHint}}"
               bind:close="closeShare" bind:image="shareImage" />

  <view class="actionbar">
    <view class="actionbar__inner">
      <view class="grow" style="margin-right:16rpx">
        <touchable cls="m3-btn m3-btn--outlined m3-btn--block" bindtap="copyText">复制文本</touchable>
      </view>
      <view class="grow">
        <touchable cls="m3-btn m3-btn--filled m3-btn--block" bindtap="openShare">分享</touchable>
      </view>
    </view>
  </view>
</view>
