<page-meta page-style="{{themeStyle}}"></page-meta>

<view class="page pad-b {{themeClass}}">
  <view class="page-head">
    <view class="t-headline-m">点名</view>
    <view class="t-body-m muted">点「到 / 假」记录，已处理自动沉底；名单与记录按账号同步</view>
  </view>

  <view class="m3-card m3-card--filled enter enter-1">
    <view class="rollstat">
      <view class="rs rs-in"><b>{{sum.inN}}</b><span>已到</span></view>
      <view class="rs rs-ab"><b>{{sum.abN}}</b><span>请假</span></view>
      <view class="rs rs-un"><b>{{sum.un}}</b><span>未点</span></view>
    </view>
    <view class="rollhint">点名字旁的「到」或「假」；已处理会自动沉到底部，再点一次可撤销。</view>
    <view class="row wrap" style="margin-top:16rpx">
      <touchable cls="m3-btn m3-btn--filled m3-btn--sm" bindtap="openPicker">选择名单</touchable>
      <touchable cls="m3-btn m3-btn--outlined m3-btn--sm" bindtap="useDraw">沿用抽签名单</touchable>
      <view class="grow"></view>
      <touchable cls="m3-btn m3-btn--text m3-btn--sm" bindtap="reset">重置本轮</touchable>
    </view>
    <view class="row between" style="margin-top:20rpx">
      <view class="row" style="gap:10rpx">
        <text class="t-body-l">名单</text>
        <text class="t-label-m muted">{{selCount ? selCount + ' 人' : '未选择'}}</text>
      </view>
      <text class="t-label-m muted">{{selCount ? '只来自班级名单' : '点「选择名单」选人'}}</text>
    </view>
  </view>

  <view class="rollgrid" wx:if="{{list.length}}">
    <view wx:for="{{list}}" wx:key="i" class="rcard {{item.s}}">
      <view class="rrow">
        <text class="rseat" wx:if="{{item.seat}}">{{item.seat}}</text>
        <text class="rnm">{{item.nm}}</text>
        <text class="rpill">{{item.s === 'in' ? '已到' : (item.s === 'ab' ? '请假' : '未点')}}</text>
      </view>
      <view class="rbtns">
        <view class="rbtn rbtn-in {{item.s === 'in' ? 'on' : ''}}" data-i="{{item.i}}" data-v="in" bindtap="toggle">到</view>
        <view class="rbtn rbtn-ab {{item.s === 'ab' ? 'on' : ''}}" data-i="{{item.i}}" data-v="ab" bindtap="toggle">假</view>
      </view>
    </view>
  </view>
  <view wx:else class="m3-card m3-card--filled">
    <empty-state icon="🙋" title="还没有名单" text="点「选择名单」从班级名单里选人，或沿用抽签名单"></empty-state>
  </view>

  <!-- —— 名单选择（只来自班级名单 class_members，液态气泡）—— -->
  <roster-picker id="rosterPicker" show="{{picker}}" title="点名名单" selected="{{rollSel}}"
                 bind:confirm="onRosterConfirm" bind:close="closePicker"></roster-picker>
</view>
