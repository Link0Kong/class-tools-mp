<page-meta page-style="{{themeStyle}}"></page-meta>

<template name="taskCard">
  <view class="tk-card {{item.done ? 'tk-card--done' : ''}}" bindtap="onTaskTap" data-id="{{item.id}}">
    <view class="tk-row">
      <view class="tk-check {{item.done ? 'on' : ''}}" catchtap="onCheck" data-id="{{item.id}}" aria-role="checkbox" aria-checked="{{item.done}}">
        <view wx:if="{{item.done}}" class="tk-ico tk-ico--check"></view>
      </view>
      <view class="tk-body">
        <view class="tk-title">{{item.title}}</view>
        <view class="tk-meta">
          <text wx:if="{{item.dueText}}" class="tk-pill {{item.overdue ? 'tk-pill--error' : 'tk-pill--primary'}}">{{item.dueText}}</text>
          <text wx:if="{{item.remindText}}" class="tk-pill">{{item.remindText}}</text>
          <text wx:if="{{item.repeatText}}" class="tk-pill">{{item.repeatText}}</text>
          <text wx:if="{{item.myDay}}" class="tk-pill">我的一天</text>
          <text wx:if="{{item.listName}}" class="tk-pill tk-pill--list"><text class="tk-dot" style="background:{{item.listHex}}"></text>{{item.listName}}</text>
          <text wx:if="{{item.stepTotal}}" class="tk-pill">步骤 {{item.stepDone}}/{{item.stepTotal}}</text>
          <text wx:if="{{item.attCount}}" class="tk-pill">附件 {{item.attCount}}</text>
          <text wx:if="{{item.sourceHw}}" class="tk-pill">班级作业</text>
          <text wx:if="{{item.sourceNotice}}" class="tk-pill">班级通知</text>
        </view>
        <view wx:if="{{item.tags.length}}" class="tk-tags">
          <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tk-tag">#{{tag}}</text>
          <text wx:if="{{item.moreTags}}" class="tk-tag">+{{item.moreTags}}</text>
        </view>
        <view wx:if="{{item.stepTotal}}" class="tk-expand" catchtap="onExpand" data-id="{{item.id}}">
          <text>{{item.expanded ? '收起步骤' : '展开步骤'}}</text><view class="tk-chev tk-ico tk-ico--chevron {{item.expanded ? 'on' : ''}}"></view>
        </view>
        <view wx:if="{{item.expanded}}" class="tk-steps">
          <view wx:for="{{item.steps}}" wx:for-item="s" wx:key="idx" class="tk-step {{s.done ? 'done' : ''}}"
                catchtap="onStepTap" data-id="{{item.id}}" data-idx="{{s.idx}}" data-done="{{s.done}}">
            <view class="tk-step-check {{s.done ? 'on' : ''}}"><view wx:if="{{s.done}}" class="tk-ico tk-ico--check"></view></view>
            <view class="tk-step-body">
              <view class="tk-step-text">{{s.text}}</view>
              <view wx:if="{{s.note}}" class="tk-step-note">{{s.note}}</view>
            </view>
          </view>
        </view>
      </view>
      <view class="tk-acts">
        <view class="tk-icon {{item.starred ? 'on' : ''}}" catchtap="onStar" data-id="{{item.id}}" aria-label="标记重要"><view class="tk-ico tk-ico--star">{{item.starred ? '★' : '☆'}}</view></view>
        <view class="tk-icon tk-icon--label" catchtap="onEdit" data-id="{{item.id}}" aria-label="编辑任务">编辑</view>
      </view>
    </view>
  </view>
</template>

<view class="page pad-b task-page {{themeClass}}">
  <top-app-bar title="任务" subtitle="未完成 {{counts.all}} 条 · 我的一天 {{counts.myday}} 条" collapsed="{{scrolled}}" />

  <view wx:if="{{classCount}}" class="task-seg">
    <segmented items="{{segs}}" value="{{seg}}" bindchange="onSeg" />
  </view>

  <view wx:if="{{state === 'error'}}" class="m3-card m3-card--outlined">
    <empty-state icon="⚠" title="读取任务失败" text="{{errorText}}" action-text="重试" bind:action="refresh"></empty-state>
  </view>

  <block wx:if="{{seg === 'my'}}">
    <view wx:if="{{remindBar.show}}" class="tk-remind">
      <view class="tk-remind-ico"><view class="tk-ico tk-ico--clock"></view></view>
      <view class="grow"><view class="tk-remind-t">{{remindBar.title}}</view><view class="tk-remind-s">{{remindBar.meta}}</view></view>
      <view class="tk-remind-a" bindtap="remindDone">完成</view>
      <view class="tk-remind-a" bindtap="remindSnooze">稍后</view>
      <view class="tk-remind-x" bindtap="remindClose"><view class="tk-ico tk-ico--close"></view></view>
    </view>

    <view class="tk-toolbar">
      <view class="tk-search-t" bindtap="toggleSearch"><view class="tk-ico tk-ico--search"></view><text>搜索</text></view>
      <view class="tk-sort" bindtap="onSort">{{sortLabel}} ▾</view>
      <view class="tk-manage" bindtap="openShare">分享</view>
      <view class="tk-manage" bindtap="openManage">管理</view>
    </view>
    <view wx:if="{{searchOpen}}" class="tk-searchrow">
      <input class="tk-search-in" value="{{ui.search}}" placeholder="搜索标题 / 备注 / 标签" bindinput="onSearchInput" confirm-type="search" />
    </view>

    <scroll-view scroll-x class="tk-chips" enhanced show-scrollbar="{{false}}">
      <view wx:for="{{views}}" wx:key="k" class="tk-chip {{item.on ? 'on' : ''}}" bindtap="onView" data-k="{{item.k}}">
        <text>{{item.n}}</text><text class="tk-chip-n">{{item.count}}</text>
      </view>
      <view wx:for="{{groups}}" wx:key="id" class="tk-chip tk-chip--group {{item.on ? 'on' : ''}}" bindtap="onGroup" data-id="{{item.id}}">
        <text class="tk-dot" style="background:{{item.hex}}"></text><text>{{item.name}}</text><text class="tk-chip-n">{{item.count}}</text>
      </view>
    </scroll-view>

    <view class="tk-quick">
      <view class="tk-quick-plus" bindtap="addQuick"><view class="tk-ico tk-ico--plus"></view></view>
      <input class="tk-quick-in" value="{{quickTitle}}" placeholder="添加任务，回车保存" bindinput="onQuickInput" bindconfirm="addQuick" confirm-type="done" />
      <view class="tk-quick-btn {{quickStar ? 'on' : ''}}" bindtap="toggleQuickStar"><view class="tk-ico tk-ico--star">{{quickStar ? '★' : '☆'}}</view></view>
      <view class="tk-quick-btn {{quickDate ? 'on' : ''}}" bindtap="toggleQuickDue"><view class="tk-ico tk-ico--chevron"></view></view>
      <view class="tk-quick-btn" bindtap="openEditor"><view class="tk-ico tk-ico--more"></view></view>
    </view>
    <view wx:if="{{quickDueOpen}}" class="tk-quickdue">
      <picker mode="date" value="{{quickDate}}" bindchange="onQuickDate"><view class="tk-field">{{quickDate || '选择日期'}}</view></picker>
      <picker mode="time" value="{{quickTime}}" bindchange="onQuickTime"><view class="tk-field">{{quickTime || '全天'}}</view></picker>
      <picker range="{{listNames}}" value="{{quickListIdx}}" bindchange="onQuickList"><view class="tk-field">{{quickListLabel}}</view></picker>
      <view class="tk-field tk-field--act" bindtap="clearQuickDue">清除</view>
    </view>
    <button class="tk-ai-entry m3-btn m3-btn--text m3-btn--sm" bindtap="openAi">{{ai.drafts.length ? '继续整理 · ' + ai.drafts.length + ' 项待填写' : 'AI 整理任务'}}</button>

    <view class="section-gap"></view>
    <view wx:if="{{!tasks.length && !doneTasks.length}}" class="m3-card m3-card--filled enter enter-1">
      <empty-state icon="📝" title="还没有任务" text="上面输入标题即可快速添加" action-text="新建任务" bind:action="openEditor"></empty-state>
    </view>
    <block wx:else>
      <template is="taskCard" wx:for="{{tasks}}" wx:key="id" data="{{item: item}}" />
    </block>

    <view wx:if="{{doneTasks.length}}" class="tk-done">
      <view class="tk-done-hd" bindtap="toggleDoneOpen"><text>已完成</text><text class="tk-done-n">{{doneTasks.length}}</text><view class="tk-chev tk-ico tk-ico--chevron {{doneOpen ? 'on' : ''}}"></view></view>
      <block wx:if="{{doneOpen}}">
        <template is="taskCard" wx:for="{{doneTasks}}" wx:key="id" data="{{item: item}}" />
      </block>
    </view>
  </block>

  <block wx:elif="{{classCount}}">
    <view class="m3-card m3-card--outlined tk-classhd enter enter-1">
      <view class="grow"><view class="tk-class-t">班级作业</view><view class="muted tk-class-s">{{classCount}} 项可加入个人待办</view></view>
      <view class="m3-btn m3-btn--tonal m3-btn--sm" bindtap="classAllToTask">全部加入</view>
      <view class="m3-btn m3-btn--text m3-btn--sm" bindtap="openHW">管理</view>
    </view>
    <view wx:for="{{classOpen}}" wx:key="id" class="m3-card m3-card--outlined tk-hwcard enter enter-2">
      <view class="tk-hw-subject" wx:if="{{item.subject}}">【{{item.subject}}】</view>
      <view class="tk-hw-content">{{item.content}}</view>
      <view class="tk-meta">
        <text wx:if="{{item.dueText}}" class="tk-pill tk-pill--primary">{{item.dueText}}</text>
        <text wx:if="{{item.dateText}}" class="tk-pill">{{item.dateText}}</text>
        <text wx:if="{{item.attCount}}" class="tk-pill">附件 {{item.attCount}}</text>
      </view>
      <view class="tk-hw-acts">
        <view class="m3-btn m3-btn--text m3-btn--sm" bindtap="openHW">详情</view>
        <view class="m3-btn m3-btn--tonal m3-btn--sm" data-id="{{item.id}}" bindtap="classToTask">加入任务</view>
      </view>
    </view>
  </block>

  <view class="tk-sync">{{syncText}}<text wx:if="{{cloudEnabled}}"> · 任务云同步</text></view>

  <!-- 详情 -->
  <bottom-sheet show="{{detail.show}}" title="" bind:close="closeDetail">
    <view wx:if="{{detail.task}}" class="tk-dt">
      <view class="tk-dt-top">
        <view class="grow">
          <view class="tk-dt-kicker">任务详情</view>
          <view class="tk-dt-title">{{detail.task.title}}</view>
          <view class="tk-dt-sub">{{detail.task.listName}}{{detail.task.done ? ' · 已完成' : ''}}{{detail.task.starred ? ' · 重要' : ''}}</view>
        </view>
        <view class="tk-dt-act {{detail.task.starred ? 'on' : ''}}" bindtap="detailStar"><view class="tk-ico tk-ico--star">{{detail.task.starred ? '★' : '☆'}}</view></view>
        <view class="tk-dt-act tk-dt-act--text" bindtap="detailEdit">编辑</view>
        <view class="tk-dt-act" bindtap="closeDetail"><view class="tk-ico tk-ico--close"></view></view>
      </view>
      <view class="tk-meta tk-dt-meta">
        <text wx:if="{{detail.task.dueText}}" class="tk-pill tk-pill--primary">{{detail.task.dueText}}</text>
        <text wx:if="{{detail.task.remindText}}" class="tk-pill">{{detail.task.remindText}}</text>
        <text wx:if="{{detail.task.repeatText}}" class="tk-pill">{{detail.task.repeatText}}</text>
        <text wx:if="{{detail.task.myDay}}" class="tk-pill">我的一天</text>
        <text wx:for="{{detail.task.tags}}" wx:key="*this" class="tk-tag">#{{item}}</text>
      </view>
      <view wx:if="{{detail.task.hasNotes}}" class="tk-dt-sec">
        <view class="tk-dt-label">备注</view><view class="tk-dt-notes">{{detail.task.notes}}</view>
      </view>
      <view wx:if="{{detail.task.steps.length}}" class="tk-dt-sec">
        <view class="tk-dt-label">步骤</view>
        <view wx:for="{{detail.task.steps}}" wx:for-item="s" wx:key="idx" class="tk-dt-step {{s.done ? 'done' : ''}}"
              bindtap="detailStep" data-idx="{{s.idx}}" data-done="{{s.done}}">
          <view class="tk-step-check {{s.done ? 'on' : ''}}"><view wx:if="{{s.done}}" class="tk-ico tk-ico--check"></view></view>
          <view class="tk-step-body"><view class="tk-step-text">{{s.text}}</view><view wx:if="{{s.note}}" class="tk-step-note">{{s.note}}</view></view>
        </view>
      </view>
      <view wx:if="{{detail.task.attachments.length}}" class="tk-dt-sec">
        <view class="tk-dt-label">附件</view>
        <view class="tk-att-row">
          <view wx:for="{{detail.task.attachments}}" wx:for-item="a" wx:key="index" class="tk-att" data-i="{{index}}" bindtap="detailAtt">
            <view class="tk-att-badge {{a.img ? 'tk-att-badge--img' : ''}}">{{a.badge}}</view><text class="tk-att-name">{{a.n}}</text><text class="muted">{{a.sizeText}}</text>
          </view>
        </view>
      </view>
      <view wx:if="{{detail.task.hasSource}}" class="tk-dt-sec">
        <view class="tk-dt-label">来源</view>
        <view class="tk-dt-src" bindtap="detailSource"><view class="grow"><view class="tk-dt-src-t">{{detail.task.sourceType}} · {{detail.task.sourceTitle}}</view><view class="tk-dt-src-s">点击定位原内容</view></view><view class="tk-ico tk-ico--chevron-right"></view></view>
      </view>
      <view class="tk-dt-times">创建 {{detail.task.createdText}} · 更新 {{detail.task.updatedText}}</view>
      <view class="tk-dt-foot">
        <view class="m3-btn m3-btn--tonal" bindtap="detailCheck">{{detail.task.done ? '标记未完成' : '标记完成'}}</view>
        <view class="m3-btn m3-btn--text" bindtap="detailShare">分享</view>
        <view wx:if="{{!detail.task.done}}" class="tk-dt-move" bindtap="moveTask" data-d="-1"><view class="tk-ico tk-ico--chevron-up"></view></view>
        <view wx:if="{{!detail.task.done}}" class="tk-dt-move" bindtap="moveTask" data-d="1"><view class="tk-ico tk-ico--chevron"></view></view>
      </view>
    </view>
  </bottom-sheet>

  <bottom-sheet show="{{ai.show}}" title="{{ai.picker ? '选择要填写的任务' : 'AI 整理任务'}}" bind:close="closeAi">
    <view wx:if="{{ai.show && !ai.picker}}">
      <view class="tk-ed-label">任务原文</view>
      <textarea class="tk-ed-textarea tk-ai-textarea" value="{{ai.text}}" maxlength="6000" disabled="{{ai.busy}}" placeholder="粘贴作业要求、待办清单，或输入你要做的事" bindinput="onAiInput"></textarea>
      <view class="tk-ai-hint">点击发送后，DeepSeek 将收到本次文字和本地日期，用于整理任务。请删去账号、密码等敏感信息。</view>
      <view wx:if="{{ai.status}}" class="tk-ai-hint" aria-live="polite">{{ai.status}}</view>
      <view class="tk-ai-actions">
        <button class="m3-btn m3-btn--text" bindtap="closeAi">关闭</button>
        <button wx:if="{{ai.drafts.length}}" class="m3-btn m3-btn--text" disabled="{{ai.busy}}" bindtap="showAiPicker">返回待填写任务</button>
        <button class="m3-btn m3-btn--filled" disabled="{{ai.busy || !ai.canSend}}" bindtap="submitAi">{{ai.busy ? '正在整理…' : '发送给云端 AI'}}</button>
      </view>
    </view>
    <view wx:elif="{{ai.show}}">
      <view class="tk-ai-hint">选择一项填入新建任务，核对后再保存。</view>
      <view wx:if="{{ai.drafts.length >= 8}}" class="tk-ai-hint">本次已整理 8 项。如果原文还有其他待办，可以分批发送。</view>
      <button wx:for="{{ai.drafts}}" wx:key="key" class="tk-ai-choice" data-index="{{index}}" bindtap="chooseAiDraft">
        <text class="tk-ai-choice-title">{{item.title}}</text>
        <view wx:if="{{item.due || item.steps.length}}" class="tk-ai-choice-meta">
          <text wx:if="{{item.due}}">{{item.due}}{{item.dueTime ? ' ' + item.dueTime : ''}}</text>
          <text wx:if="{{item.steps.length}}">{{item.steps.length}} 个步骤</text>
        </view>
      </button>
      <view class="tk-ai-actions">
        <button class="m3-btn m3-btn--text" bindtap="closeAi">关闭</button>
        <button class="m3-btn m3-btn--text" bindtap="showAiInput">整理其他文字</button>
      </view>
    </view>
  </bottom-sheet>

  <!-- 编辑器 -->
  <bottom-sheet show="{{editor.show}}" title="{{editor.isNew ? '新建任务' : '编辑任务'}}" bind:close="closeEditor">
    <view wx:if="{{editor.show}}" class="tk-ed">
      <view class="tk-ed-label">标题</view>
      <input class="tk-ed-input tk-ed-title" value="{{editor.title}}" maxlength="200" placeholder="任务标题" data-k="title" bindinput="onEditInput" />
      <view class="tk-ed-label">备注</view>
      <textarea class="tk-ed-textarea" value="{{editor.notes}}" maxlength="5000" placeholder="补充说明、链接、注意事项（可选）" data-k="notes" bindinput="onEditInput" auto-height></textarea>

      <view class="tk-ed-label">时间</view>
      <view class="tk-date-row">
        <picker mode="date" value="{{editor.due}}" bindchange="onEditDate"><view class="tk-field">{{editor.due || '选择日期'}}</view></picker>
        <picker mode="time" value="{{editor.dueTime}}" bindchange="onEditTime"><view class="tk-field">{{editor.dueTime || '全天'}}</view></picker>
        <view class="tk-field tk-field--act" catchtap="clearEditorDue">清除</view>
      </view>

      <view class="tk-ed-label">提醒</view>
      <view class="tk-date-row">
        <picker range="{{remindOptions}}" value="{{editor.remindIdx}}" bindchange="onEditRemind"><view class="tk-field">{{editor.remindLabel}}</view></picker>
        <picker wx:if="{{editor.remindMode === 'custom'}}" mode="date" value="{{editor.customDate}}" bindchange="onEditCustomDate"><view class="tk-field">{{editor.customDate}}</view></picker>
        <picker wx:if="{{editor.remindMode === 'custom'}}" mode="time" value="{{editor.customTime}}" bindchange="onEditCustomTime"><view class="tk-field">{{editor.customTime}}</view></picker>
      </view>

      <view class="tk-ed-label">重复 / 分组</view>
      <view class="tk-date-row">
        <picker range="{{repeatOptions}}" value="{{editor.repeatIdx}}" bindchange="onEditRepeat"><view class="tk-field">{{editor.repeatLabel}}</view></picker>
        <picker range="{{listNames}}" value="{{editor.listIdx}}" bindchange="onEditList"><view class="tk-field">{{editor.listLabel}}</view></picker>
      </view>

      <view class="tk-ed-label">标签</view>
      <input class="tk-ed-input" value="{{editor.tagsText}}" placeholder="如 复习, 截止（逗号分隔）" maxlength="120" data-k="tagsText" bindinput="onEditInput" />

      <view class="tk-ed-label">步骤 <text class="muted">{{editor.steps.length}}/50</text></view>
      <view class="tk-ed-steps">
        <view wx:for="{{editor.steps}}" wx:for-item="s" wx:key="index" class="tk-ed-step">
          <view class="tk-step-line">
            <view class="tk-check {{s.done ? 'on' : ''}}" catchtap="onEditStepDone" data-i="{{index}}"><view wx:if="{{s.done}}" class="tk-ico tk-ico--check"></view></view>
            <input class="tk-ed-step-in" value="{{s.text}}" maxlength="120" placeholder="步骤" data-i="{{index}}" bindinput="onEditStepText" />
            <view class="tk-del" catchtap="onEditStepDel" data-i="{{index}}"><view class="tk-ico tk-ico--close"></view></view>
          </view>
          <textarea class="tk-ed-step-note" value="{{s.note}}" maxlength="500" placeholder="步骤备注（可选）" data-i="{{index}}" bindinput="onEditStepNote" auto-height></textarea>
        </view>
      </view>
      <view class="tk-step-add">
        <input class="tk-ed-input" value="{{editor.stepAdd}}" placeholder="添加步骤，回车保存" maxlength="120" bindinput="onStepAddInput" bindconfirm="addEditStep" confirm-type="done" />
        <view class="m3-btn m3-btn--tonal m3-btn--sm" bindtap="addEditStep">添加</view>
      </view>

      <view class="tk-ed-label">附件 <text class="muted">最多 2 个 · 仅本机</text></view>
      <view class="tk-att-row">
        <view wx:for="{{editor.attachments}}" wx:for-item="a" wx:key="index" class="tk-att" data-i="{{index}}" bindtap="previewEditorAtt">
          <view class="tk-att-badge {{a.img ? 'tk-att-badge--img' : ''}}">{{a.badge}}</view><text class="tk-att-name">{{a.n}}</text><text class="muted">{{a.sizeText}}</text>
          <view class="tk-att-x" catchtap="removeAttachment" data-i="{{index}}"><view class="tk-ico tk-ico--close"></view></view>
        </view>
        <view wx:if="{{editor.attachments.length < 2}}" class="tk-att tk-att--add" bindtap="chooseAttachment"><view class="tk-ico tk-ico--plus"></view><text>添加附件</text></view>
      </view>

      <view class="tk-ed-flags">
        <view class="tk-flag {{editor.starred ? 'on' : ''}}" bindtap="toggleEditStar">重要</view>
        <view class="tk-flag {{editor.myDay ? 'on' : ''}}" bindtap="toggleEditMyDay">我的一天</view>
        <view class="tk-flag {{editor.done ? 'on' : ''}}" bindtap="toggleEditDone">已完成</view>
      </view>

      <view class="tk-ed-foot">
        <view wx:if="{{!editor.isNew}}" class="m3-btn m3-btn--text tk-danger" bindtap="deleteEditor">删除</view>
        <view class="grow"></view>
        <view class="m3-btn m3-btn--text" bindtap="closeEditor">取消</view>
        <view class="m3-btn m3-btn--filled" bindtap="saveEditor">保存</view>
      </view>
    </view>
  </bottom-sheet>

  <!-- 管理：视图/分组顺序 -->
  <bottom-sheet show="{{manage.show}}" title="任务管理" bind:close="closeManage">
    <view wx:if="{{manage.show}}" class="tk-manage-panel">
      <view class="m3-btn m3-btn--tonal tk-manage-add" bindtap="openHW">管理班级作业</view>
      <view class="tk-manage-label">视图顺序</view>
      <view wx:for="{{manage.views}}" wx:key="k" class="tk-manage-row">
        <text class="grow">{{item.n}}</text>
        <view class="tk-move" data-i="{{item.i}}" data-d="-1" bindtap="moveView"><view class="tk-ico tk-ico--chevron-up"></view></view>
        <view class="tk-move" data-i="{{item.i}}" data-d="1" bindtap="moveView"><view class="tk-ico tk-ico--chevron"></view></view>
      </view>
      <view class="tk-manage-label">分组顺序</view>
      <view wx:for="{{manage.groups}}" wx:key="id" class="tk-manage-row">
        <text class="tk-dot" style="background:{{item.hex}}"></text><text class="grow">{{item.name}}</text>
        <view class="tk-move" data-i="{{item.i}}" data-d="-1" bindtap="moveGroup"><view class="tk-ico tk-ico--chevron-up"></view></view>
        <view class="tk-move" data-i="{{item.i}}" data-d="1" bindtap="moveGroup"><view class="tk-ico tk-ico--chevron"></view></view>
        <view class="tk-move tk-move--text" data-id="{{item.id}}" bindtap="openGroupForm">编辑</view>
      </view>
      <view class="tk-manage-label">默认提醒</view>
      <view class="tk-manage-row">
        <text class="grow">新建任务时默认</text>
        <picker range="{{defaultRemindOptions}}" value="{{defaultRemindIdx}}" bindchange="onDefaultRemind">
          <view class="tk-field tk-field--mini">{{defaultRemindLabel}}</view>
        </picker>
      </view>
      <view class="m3-btn m3-btn--tonal tk-manage-add" bindtap="openGroupForm"><view class="tk-ico tk-ico--plus"></view><text>新建分组</text></view>
      <view class="m3-btn m3-btn--text tk-manage-add" bindtap="exportIcs">导出日历（.ics）</view>
    </view>
  </bottom-sheet>

  <!-- 分组编辑 -->
  <bottom-sheet show="{{groupForm.show}}" title="{{groupForm.isNew ? '新建分组' : '编辑分组'}}" bind:close="closeGroupForm">
    <view wx:if="{{groupForm.show}}" class="tk-groupform">
      <input class="tk-ed-input" value="{{groupForm.name}}" maxlength="20" placeholder="分组名称" bindinput="onGroupName" />
      <view class="tk-colors">
        <view wx:for="{{groupForm.colors}}" wx:for-item="c" wx:key="*this" class="tk-color tk-color--{{c}} {{groupForm.color === c ? 'on' : ''}}" data-c="{{c}}" bindtap="pickGroupColor"></view>
      </view>
      <view class="tk-ed-foot">
        <view wx:if="{{!groupForm.isNew}}" class="m3-btn m3-btn--text tk-danger" bindtap="deleteGroupForm">删除</view>
        <view class="grow"></view>
        <view class="m3-btn m3-btn--text" bindtap="closeGroupForm">取消</view>
        <view class="m3-btn m3-btn--filled" bindtap="saveGroupForm">保存</view>
      </view>
    </view>
  </bottom-sheet>

  <bottom-sheet show="{{shared.show}}" title="分享的任务" bind:close="closeShared">
    <view wx:if="{{shared.show}}" class="tk-shared">
      <view class="tk-shared-t">{{shared.t}}</view>
      <view class="tk-shared-s">{{shared.l}}<text wx:if="{{shared.d}}"> · {{shared.d}}</text></view>
      <view wx:if="{{shared.steps.length}}" class="tk-shared-steps">
        <view wx:for="{{shared.steps}}" wx:key="*this" class="tk-shared-step">{{index + 1}} {{item}}</view>
      </view>
      <view wx:if="{{shared.note}}" class="tk-dt-notes">{{shared.note}}</view>
      <view class="tk-shared-tip">分享预览只含标题、截止与步骤；不含附件和来源。</view>
      <view class="tk-ed-foot">
        <view class="m3-btn m3-btn--text" bindtap="closeShared">关闭</view>
        <view class="grow"></view>
        <view class="m3-btn m3-btn--filled" bindtap="saveShared">保存为我的任务</view>
      </view>
    </view>
  </bottom-sheet>

  <canvas type="2d" id="card" class="exp-canvas"></canvas>
  <canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>
  <share-sheet show="{{shareSheet}}" preview="{{shareImg}}" preview-alt="{{sharePoster}}"
               title-text="{{shareTitle}}" busy="{{shareBusy}}" hint="{{shareHint}}"
               bind:close="closeShare" bind:image="shareImage" />
</view>
