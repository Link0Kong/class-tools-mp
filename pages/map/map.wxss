.campus{height:100vh;display:flex;flex-direction:column;overflow:hidden;color:var(--md-on-surface);background:var(--md-surface)}
.campus button{margin:0;padding:0 10px;min-height:42px;line-height:40px;font-size:13px;border-radius:8px;
  color:var(--md-on-surface);background:var(--md-surface-container-lowest);border:1px solid var(--md-outline-variant);white-space:nowrap}
.campus button::after{border:0}
.campus button.on{color:var(--md-on-primary-container);background:var(--md-primary-container);font-weight:700}
.campus button.icon{min-width:42px;font-size:21px}
.mbar{position:relative;z-index:3;display:flex;align-items:center;flex:none;gap:8px;padding:8px 10px;border-bottom:1px solid var(--md-outline-variant);
  background:var(--md-surface-container-lowest)}
.msearchbox{display:flex;align-items:center;flex:1;min-width:0;padding-left:10px;background:var(--md-surface-container-low);
  border:1px solid var(--md-outline-variant);border-radius:10px}
.msearch{flex:1;min-width:0;height:42px;font-size:15px;color:var(--md-on-surface)}
.campus button.clear{min-height:40px;line-height:38px;padding:0;background:transparent;border:0}
.modes{display:flex;flex:none;gap:2px;background:var(--md-surface-container);padding:2px;border-radius:10px}
.modes button{padding:0 8px;min-width:44px;border:0;background:transparent}
.suggestions{position:absolute;top:100%;left:10px;width:calc(100% - 20px);max-width:430px;max-height:50vh;
  background:var(--md-surface-container-lowest);border-radius:10px;border:1px solid var(--md-outline-variant)}
.campus button.suggestion{display:block;width:100%;padding:7px 12px;height:auto;line-height:1.45;text-align:left;
  border:0;border-radius:0;border-bottom:1px solid var(--md-outline-variant)}
.result-title{display:block;font-weight:700}
.result-sub,.empty{font-size:12px;color:var(--md-on-surface-variant)}
.empty{display:block;padding:12px}
.mstage{flex:1;min-height:0;position:relative;overflow:hidden}
.mcanvas{width:100%;height:100%;display:block}
.mtools{position:absolute;top:9px;right:9px;display:flex;padding:2px;gap:2px;border-radius:10px;background:var(--md-surface-container-lowest);
  border:1px solid var(--md-outline-variant);box-shadow:var(--md-elev-2)}
.mtools button{border:0;padding:0 8px}
.about{position:absolute;left:9px;bottom:9px;bottom:max(9px,env(safe-area-inset-bottom))}
.mloading{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);padding:12px;white-space:nowrap;background:var(--md-surface-container-lowest);
  border-radius:10px;font-size:13px;text-align:center}
.mloading button{margin-top:8px}
.msheet{position:absolute;left:8px;right:8px;bottom:8px;bottom:max(8px,env(safe-area-inset-bottom));max-width:460px;
  border:1px solid var(--md-outline-variant);border-radius:13px;background:var(--md-surface-container-lowest);box-shadow:var(--md-elev-2)}
.mshead{display:flex;align-items:center;gap:4px;padding:5px 7px 5px 11px}
.msinfo{flex:1;min-width:0}
.msname{display:block;font-size:16px;line-height:1.3;font-weight:700;overflow-wrap:anywhere}
.msmeta{display:block;margin-top:3px;color:var(--md-on-surface-variant);font-size:12px;line-height:1.5;overflow-wrap:anywhere}
.msbody{max-height:30vh;box-sizing:border-box;padding:4px 11px 10px}
.msroute{padding-top:6px;border-top:1px solid var(--md-outline-variant)}
.route-label{font-size:13px;font-weight:700}
.msactions,.floors,.rooms{display:flex;flex-wrap:wrap;gap:6px}
.msactions{margin-top:8px}
.msactions button{flex:1}
.moverlay{position:fixed;inset:0;z-index:6;display:flex;justify-content:center;align-items:center}
.backdrop{position:absolute;inset:0;background:#17241F85}
.floor-sheet{position:relative;width:calc(100% - 24px);max-width:760px;background:var(--md-surface-container-lowest);
  border:1px solid var(--md-outline-variant);border-radius:15px}
.floor-body{box-sizing:border-box;max-height:76vh;padding:4px 12px 12px}
.rooms{margin-top:10px}
.origins,.floor-tools{display:flex;flex-wrap:wrap;gap:6px;margin:5px 0}
.floor-plan{display:block;width:100%;height:30vh;min-height:130px;max-height:280px;border-radius:9px}
.org-picker{margin:8px 0;padding:10px;border:1px solid var(--md-outline-variant);border-radius:8px}
.campus .rooms button{height:auto;max-width:100%;text-align:left;line-height:1.35;white-space:normal;padding:7px 10px}
@media (min-width:720px){.msheet{left:auto;top:64px;bottom:auto;width:300px}.msbody{max-height:58vh}}
