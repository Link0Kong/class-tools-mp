/* pages/votedetail/votedetail.wxss —— 投票详情 / 结果 / 管理（只用 app.wxss 的 M3 token，无新配色） */

.vd-page { padding-top: 16rpx; }
.vd-sk { padding: 24rpx 0; }

/* ---------- 顶部 ---------- */
.vd-hero {
  padding: 32rpx 32rpx 24rpx; margin-bottom: 20rpx; border-radius: var(--md-shape-xl);
  background: var(--md-primary-container); color: var(--md-on-primary-container);
}
.vd-hero-hd { display: flex; align-items: center; justify-content: space-between; }
.vd-pill {
  padding: 6rpx 20rpx; border-radius: var(--md-shape-full);
  background: rgba(255, 255, 255, .45); color: var(--md-on-primary-container);
  font-size: 22rpx; font-weight: 600;
}
.vd-pill--off { background: rgba(0, 0, 0, .10); }
.vd-cd { font-size: 28rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.vd-cd--off { opacity: .7; font-weight: 500; }
.vd-title { margin-top: 18rpx; font-size: 42rpx; font-weight: 600; line-height: 1.3; word-break: break-all; }
.vd-sub { margin-top: 10rpx; font-size: 24rpx; opacity: .78; }
.vd-desc { margin-top: 16rpx; font-size: 28rpx; line-height: 1.55; opacity: .92; white-space: pre-wrap; word-break: break-all; }
.vd-tags { display: flex; flex-wrap: wrap; margin-top: 18rpx; }
.vd-tag {
  margin: 0 10rpx 10rpx 0; padding: 6rpx 18rpx; border-radius: var(--md-shape-full);
  background: rgba(255, 255, 255, .42); color: var(--md-on-primary-container); font-size: 22rpx; font-weight: 500;
}
.vd-stats { display: flex; margin-top: 20rpx; }
.vd-stat {
  flex: 1; padding: 16rpx 20rpx; margin-right: 12rpx; border-radius: var(--md-shape-md);
  background: rgba(255, 255, 255, .40);
}
.vd-stat:last-child { margin-right: 0; }
.vd-stat-v { font-size: 36rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.vd-stat-l { margin-top: 2rpx; font-size: 22rpx; opacity: .72; }

/* 分享入口（2026-11-19）：原生 button open-type=share；点按区 ≥40px */
.vd-sharebar { display: flex; align-items: center; margin: -4rpx 0 20rpx; }
.vd-share-hint { margin-left: 16rpx; font-size: 22rpx; color: var(--md-on-surface-variant); }
.share-btn {
  margin: 0; padding: 0 30rpx; height: 80rpx; min-height: 80rpx; line-height: 80rpx;
  display: inline-flex; align-items: center; justify-content: center;
  border: 0; border-radius: var(--md-shape-full);
  background: var(--md-primary-container); color: var(--md-on-primary-container);
  font-size: 26rpx; font-weight: 600;
}
.share-btn::after { border: 0; }
/* 5:4 分享卡画布（离屏；详情渲染后异步生成，失败回退 images/share/default.png） */
.share-canvas { position: fixed; left: -10000rpx; top: 0; width: 500px; height: 400px; pointer-events: none; }

.vd-hide {
  margin-bottom: 20rpx; padding: 20rpx 28rpx; border-radius: var(--md-shape-md);
  background: var(--md-tertiary-container); color: var(--md-on-tertiary-container); font-size: 26rpx;
}

/* ---------- 卡片 ---------- */
.vd-card {
  padding: 28rpx; margin-bottom: 20rpx; border-radius: var(--md-shape-lg);
  background: var(--md-surface-container-low); box-shadow: var(--md-elev-1);
}
.vd-card-t { margin-bottom: 16rpx; font-size: 26rpx; font-weight: 600; color: var(--md-on-surface-variant); }

/* ---------- 选项 ---------- */
.vd-opt {
  display: flex; align-items: flex-start; padding: 24rpx 20rpx; margin-bottom: 12rpx;
  border-radius: var(--md-shape-md); border: 2rpx solid var(--md-outline-variant);
  background: var(--md-surface-container-lowest);
  transition: background var(--md-dur-short) var(--md-ease-standard), border-color var(--md-dur-short) var(--md-ease-standard);
}
.vd-opt:last-child { margin-bottom: 0; }
.vd-opt--on { border-color: var(--md-primary); background: var(--md-primary-container); }
.vd-opt--tap:active { opacity: .86; }
.vd-box {
  flex: none; width: 44rpx; height: 44rpx; margin: 2rpx 20rpx 0 0; box-sizing: border-box;
  border-radius: var(--md-shape-full); border: 3rpx solid var(--md-outline);
  display: flex; align-items: center; justify-content: center;
  color: var(--md-on-primary); font-size: 28rpx; font-weight: 700;
}
.vd-box--multi { border-radius: 10rpx; }
.vd-box--on { background: var(--md-primary); border-color: var(--md-primary); }
.vd-box-t { line-height: 1; }
.vd-opt-main { flex: 1; min-width: 0; }
.vd-opt-t { font-size: 30rpx; font-weight: 500; color: var(--md-on-surface); line-height: 1.4; word-break: break-all; }
.vd-opt-d { margin-top: 6rpx; font-size: 24rpx; color: var(--md-on-surface-variant); line-height: 1.5; word-break: break-all; }
.vd-opt-img {
  width: 240rpx; height: 160rpx; margin-top: 12rpx; border-radius: var(--md-shape-sm);
  background: var(--md-surface-container-high);
}
.vd-bar {
  height: 14rpx; margin-top: 14rpx; border-radius: var(--md-shape-full);
  background: var(--md-surface-container-highest); overflow: hidden;
}
.vd-bar-in { height: 100%; border-radius: var(--md-shape-full); background: var(--md-primary); }
.vd-opt-n { flex: none; margin-left: 16rpx; text-align: right; }
.vd-opt-pct { display: block; font-size: 28rpx; font-weight: 600; color: var(--md-on-surface); font-variant-numeric: tabular-nums; }
.vd-opt-cnt { display: block; margin-top: 2rpx; font-size: 22rpx; color: var(--md-on-surface-variant); }

/* ---------- 投票人（实名） ---------- */
.vd-voter {
  display: flex; align-items: baseline; padding: 14rpx 0;
  border-bottom: 1rpx solid var(--md-outline-variant);
}
.vd-voter:last-child { border-bottom: none; padding-bottom: 0; }
.vd-voter-n { flex: none; width: 180rpx; font-size: 28rpx; font-weight: 500; color: var(--md-on-surface); }
.vd-voter-c { flex: 1; min-width: 0; font-size: 24rpx; color: var(--md-on-surface-variant); word-break: break-all; }

/* ---------- 管理 ---------- */
.vd-mbtns { display: flex; flex-wrap: wrap; }
.vd-mbtn {
  margin: 0 16rpx 16rpx 0; padding: 16rpx 32rpx; border-radius: var(--md-shape-full);
  background: var(--md-surface-container-high); color: var(--md-on-surface); font-size: 26rpx; font-weight: 500;
}
.vd-mbtn--danger { background: var(--md-error-container); color: var(--md-on-error-container); }
.vd-manage-hint { margin-top: 4rpx; font-size: 22rpx; color: var(--md-on-surface-variant); }

/* ---------- 底部操作条 ---------- */
.vd-sel { flex: none; margin-right: 16rpx; font-size: 24rpx; color: var(--md-on-surface-variant); }

/* ---------- 延长/重开弹层 ---------- */
.vd-sheet { display: flex; flex-direction: column; padding-bottom: calc(var(--md-space-4) + env(safe-area-inset-bottom)); }
.vd-sheet-hd { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.vd-sheet-t { font-size: 36rpx; font-weight: 600; color: var(--md-on-surface); }
.vd-sheet-x {
  width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; color: var(--md-on-surface-variant);
}
.vd-sheet-label { margin: 16rpx 0 12rpx; font-size: 24rpx; font-weight: 500; color: var(--md-on-surface-variant); }
.vd-quicks { display: flex; flex-wrap: wrap; }
.vd-quick {
  margin: 0 12rpx 12rpx 0; padding: 14rpx 26rpx; border-radius: var(--md-shape-full);
  background: var(--md-surface-container-high); color: var(--md-on-surface-variant); font-size: 26rpx;
}
.vd-quick--on { background: var(--md-primary-container); color: var(--md-on-primary-container); font-weight: 600; }
.vd-dt { display: flex; margin-top: 8rpx; }
.vd-dt-btn {
  flex: 1; height: 84rpx; display: flex; align-items: center; justify-content: center; margin-right: 16rpx;
  border-radius: var(--md-shape-sm); background: var(--md-surface-container-high);
  font-size: 30rpx; color: var(--md-on-surface); font-variant-numeric: tabular-nums;
}
.vd-sheet-ft {
  display: flex; align-items: center; margin-top: 24rpx; padding-top: 20rpx;
  border-top: 1rpx solid var(--md-outline-variant);
}

/* 2026-11-15 深色 hero 中性化（对齐安卓 v4.55）：大面积 primary-container 在深色下改中性 tonal 深色，
   品牌绿只保留小面积（徽标/数字/按钮）。浅色不变；.theme-dark 由 utils/appearance.js 注入页面根节点。 */
.theme-dark .vd-hero { background: var(--md-surface-container-high); color: var(--md-on-surface); }
.theme-dark .vd-pill { background: var(--md-surface-container-highest); color: var(--md-on-surface-variant); }
