/* pages/pptdl/pptdl.wxss —— 下载中心详情（暖白卡片 + 雾青主色；契约 §12.4.1）
 * 尺寸按 750 设计宽（1px = 2rpx）；触控区域 ≥ 80rpx（40px）。 */

.dl-page { padding-top: 8rpx; }

/* ---------------- 头部：封面 + 标题 + 元信息 ---------------- */
.dl-head {
  display: flex; flex-direction: row; align-items: center;
  padding: 12rpx 0 20rpx;
}
.dl-cover {
  width: 192rpx; height: 108rpx; border-radius: 16rpx; overflow: hidden; flex: none;
  background: var(--md-surface-container);
  display: flex; align-items: center; justify-content: center;
}
.dl-cover-img { width: 100%; height: 100%; display: block; }
.dl-cover-ph { font-size: 48rpx; opacity: .35; }
.dl-head-main { flex: 1; min-width: 0; margin-left: 20rpx; }
.dl-title {
  font-size: 32rpx; font-weight: 600; line-height: 1.35; color: var(--md-on-surface);
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.dl-meta {
  margin-top: 8rpx; font-size: 24rpx; color: var(--md-on-surface-variant);
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.dl-state {
  margin-top: 8rpx; font-size: 24rpx; font-weight: 500; color: var(--md-primary);
}

/* ---------------- 状态/空态 ---------------- */
.dl-busy { padding: 28rpx 24rpx; }
.dl-busy-t { font-size: 30rpx; font-weight: 600; color: var(--md-on-surface); }
.dl-busy-hint {
  margin-top: 12rpx; font-size: 24rpx; line-height: 1.5; color: var(--md-on-surface-variant);
  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
}
.dl-empty { padding: 40rpx 24rpx; display: flex; flex-direction: column; align-items: center; }
.dl-empty-t { font-size: 28rpx; color: var(--md-on-surface-variant); margin-bottom: 20rpx; }

/* ---------------- 按钮（触控 ≥40px） ---------------- */
.dl-actions { margin-top: 20rpx; display: flex; flex-direction: row; align-items: center; flex-wrap: wrap; }
.dl-btn {
  min-height: 80rpx; padding: 0 32rpx; border-radius: 24rpx; margin-right: 16rpx; margin-bottom: 8rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: 500; box-sizing: border-box;
}
.dl-btn--tap { opacity: .86; }
.dl-btn--filled { background: var(--md-primary); color: var(--md-on-primary); box-shadow: var(--md-elev-1); }
.dl-btn--outline { border: 2rpx solid var(--md-primary); color: var(--md-primary); background: transparent; }
.dl-btn--text { color: var(--md-primary); background: transparent; padding: 0 20rpx; }
.dl-btn--cancel { background: var(--md-error-container); color: var(--md-on-error-container); }

/* ---------------- 旧 deck 提示 ---------------- */
.dl-legacy { padding: 24rpx; }
.dl-legacy-t { font-size: 28rpx; font-weight: 600; color: var(--md-on-surface); }

/* ---------------- 兼容提示（橙色逐条） ---------------- */
.dl-warn {
  padding: 22rpx 24rpx; margin-bottom: 16rpx;
  background: #FBF1E4; border: 2rpx solid #E8C79E;
}
.dl-warn-t { font-size: 26rpx; font-weight: 600; color: #8A5A22; margin-bottom: 10rpx; }
.dl-warn-list { display: flex; flex-direction: column; }
.dl-warn-i { font-size: 24rpx; line-height: 1.6; color: #8A5A22; word-break: break-word; }

/* ---------------- 文件行 ---------------- */
.dl-list { display: flex; flex-direction: column; }
.dl-row { padding: 22rpx 24rpx; margin-bottom: 16rpx; }
.dl-row--dl { border: 2rpx solid var(--md-primary); }
.dl-row-top { display: flex; flex-direction: row; align-items: center; }
.dl-row-main { flex: 1; min-width: 0; }
.dl-row-t { font-size: 30rpx; font-weight: 600; color: var(--md-on-surface); }
.dl-row-meta { margin-top: 6rpx; font-size: 24rpx; color: var(--md-on-surface-variant); }
.dl-dlbtn { flex: none; margin-left: 20rpx; }
.dl-progress {
  margin-top: 16rpx; height: 8rpx; border-radius: 4rpx; overflow: hidden;
  background: var(--md-surface-container-high);
}
.dl-progress-bar { height: 100%; background: var(--md-primary); transition: width 200ms linear; }
.dl-progress-t { margin-top: 8rpx; font-size: 22rpx; color: var(--md-primary); }
.dl-row-sub { margin-top: 12rpx; display: flex; flex-direction: row; align-items: center; }
.dl-subbtn {
  min-height: 64rpx; line-height: 64rpx; padding: 0 20rpx; margin-right: 12rpx;
  font-size: 24rpx; color: var(--md-primary); border-radius: 16rpx;
  background: var(--md-surface-container-low);
}

/* ---------------- 视频/音频单独下载分组（§12.8） ---------------- */
.dl-media { margin-top: 8rpx; margin-bottom: 8rpx; }
.dl-media-hd {
  padding: 8rpx 4rpx 16rpx;
  font-size: 28rpx; font-weight: 600; color: var(--md-on-surface);
}
.dl-row--media { padding: 20rpx 24rpx; }

/* ---------------- 在线预览（次级入口） ---------------- */
.dl-preview { margin-top: 8rpx; display: flex; flex-direction: row; justify-content: center; }

/* ---------------- 骨架 ---------------- */
.dl-sk { padding: 24rpx; margin-bottom: 16rpx; }
