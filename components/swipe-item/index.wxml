<view class="sw">
  <view class="sw__acts" style="width:{{width}}rpx">
    <view class="sw__act sw__act--{{item.type || 'neutral'}}" wx:for="{{actions}}" wx:key="id"
          data-id="{{item.id}}" bindtap="onAct" hover-class="sw__act--hover" hover-stay-time="80">{{item.label}}</view>
  </view>
  <view class="sw__body" style="transform:translateX({{x}}rpx)"
        bindtouchstart="onStart" bindtouchmove="onMove" bindtouchend="onEnd" bindtouchcancel="onEnd"
        bindlongpress="onLongPress">
    <slot></slot>
  </view>
</view>
