.tch { position: relative; overflow: hidden; width: 100%; box-sizing: border-box; }
.tch__press { position: absolute; left: 0; top: 0; right: 0; bottom: 0; pointer-events: none; transition: background 200ms cubic-bezier(0.2,0,0,1); }
.tch__rip {
  position: absolute; border-radius: 50%; pointer-events: none;
  background: currentColor; opacity: 0.18; transform: scale(0);
  animation: tchRipple 420ms cubic-bezier(0.2,0,0,1) forwards;
}
@keyframes tchRipple { to { transform: scale(1); opacity: 0; } }
