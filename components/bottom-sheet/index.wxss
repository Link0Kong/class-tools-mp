.bs { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 100; }
.bs__mask { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0,0,0,.38);
  animation: bsFade 200ms cubic-bezier(0.2,0,0,1) both; }
.bs__sheet { position: absolute; left: 0; right: 0; bottom: 0;
  background: var(--md-surface-container-low, #F7F3EA);
  border-radius: 56rpx 56rpx 0 0; padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  animation: bsUp 300ms cubic-bezier(0.05,0.7,0.1,1) both;
  max-height: 86vh; display: flex; flex-direction: column; overflow: hidden; }
.bs__body { flex: 1; min-height: 0; overflow-y: auto; -webkit-overflow-scrolling: touch; padding-bottom: 8rpx; }
.bs__grabber { width: 64rpx; height: 8rpx; border-radius: 999rpx; background: var(--md-outline-variant, #E7DED0); margin: 0 auto 24rpx; }
.bs__title { margin-bottom: 24rpx; }
@keyframes bsUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
@keyframes bsFade { from { opacity: 0; } to { opacity: 1; } }
