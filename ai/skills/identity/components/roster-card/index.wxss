.card {
  padding: 24rpx 28rpx 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}
.hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1B1F;
}
.cnt {
  font-size: 22rpx;
  color: #6E8CA8;
}
.row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #F1F1F1;
}
.seat {
  width: 70rpx;
  font-size: 24rpx;
  color: #9AA7B5;
}
.name {
  font-size: 28rpx;
  color: #1C1B1F;
}
.role {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: #4E9082;
  background: #E6F2EE;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}
.admin {
  margin-left: 10rpx;
  font-size: 22rpx;
  color: #B98F63;
  background: #F7EFE4;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}
.more {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #8C8C8C;
}
@media (prefers-color-scheme: dark) {
  .card { background: #1F1F24; }
  .title { color: #ECECEC; }
  .cnt { color: #9DB4CC; }
  .row { border-bottom: 1rpx solid #333338; }
  .seat { color: #8C99A6; }
  .name { color: #ECECEC; }
  .role { color: #8FCFC0; background: #23332F; }
  .admin { color: #D9B98F; background: #33291F; }
  .more { color: #9A9A9A; }
}
