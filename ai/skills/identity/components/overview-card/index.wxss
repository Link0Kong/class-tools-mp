.card {
  padding: 24rpx 28rpx 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}
.hd { margin-bottom: 18rpx; }
.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1B1F;
}
.grid {
  display: flex;
  flex-wrap: wrap;
}
.cell {
  width: 50%;
  padding: 12rpx 0;
  box-sizing: border-box;
}
.num {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  color: #4E9082;
}
.lb {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #6E8CA8;
}
@media (prefers-color-scheme: dark) {
  .card { background: #1F1F24; }
  .title { color: #ECECEC; }
  .num { color: #8FCFC0; }
  .lb { color: #9DB4CC; }
}
