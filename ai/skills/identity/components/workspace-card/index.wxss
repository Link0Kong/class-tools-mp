.card {
  padding: 24rpx 28rpx 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}
.hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1B1F;
}
.week {
  font-size: 22rpx;
  color: #4E9082;
  background: #E6F2EE;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}
.blk {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #F1F1F1;
}
.blk-t {
  font-size: 24rpx;
  color: #6E8CA8;
}
.course {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}
.time {
  width: 180rpx;
  font-size: 22rpx;
  color: #8C8C8C;
}
.cname {
  font-size: 28rpx;
  color: #1C1B1F;
}
.room {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: #B98F63;
}
.next {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 8rpx;
}
.meta {
  margin-left: 14rpx;
  font-size: 22rpx;
  color: #8C8C8C;
}
.empty {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8C8C8C;
}
.todo {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}
.todo-lb {
  font-size: 26rpx;
  color: #1C1B1F;
}
.todo-num {
  font-size: 34rpx;
  font-weight: 600;
  color: #4E9082;
}
.urgent {
  font-size: 22rpx;
  color: #8C8C8C;
  padding-bottom: 6rpx;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}
.chip {
  margin: 0 12rpx 12rpx 0;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #4E9082;
  background: #E6F2EE;
  border-radius: 999rpx;
}
@media (prefers-color-scheme: dark) {
  .card { background: #1F1F24; }
  .title { color: #ECECEC; }
  .week { color: #8FCFC0; background: #23332F; }
  .blk { border-top: 1rpx solid #333338; }
  .blk-t { color: #9DB4CC; }
  .cname { color: #ECECEC; }
  .time { color: #9A9A9A; }
  .room { color: #D9B98F; }
  .meta { color: #9A9A9A; }
  .empty { color: #9A9A9A; }
  .todo-lb { color: #ECECEC; }
  .todo-num { color: #8FCFC0; }
  .urgent { color: #9A9A9A; }
  .chip { color: #8FCFC0; background: #23332F; }
}
