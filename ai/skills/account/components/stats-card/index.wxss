.card {
  padding: 24rpx 28rpx 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}
.hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1B1F;
}
.range {
  font-size: 22rpx;
  color: #6E8CA8;
}
.sum {
  display: flex;
}
.sum-cell {
  width: 50%;
  padding: 10rpx 0;
}
.num {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #4E9082;
}
.lb {
  display: block;
  font-size: 22rpx;
  color: #6E8CA8;
}
.sec {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #F1F1F1;
}
.sec-t {
  font-size: 24rpx;
  color: #6E8CA8;
}
.row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}
.name {
  width: 240rpx;
  font-size: 24rpx;
  color: #1C1B1F;
}
.v {
  width: 140rpx;
  font-size: 24rpx;
  color: #4E9082;
}
.last {
  flex: 1;
  font-size: 22rpx;
  color: #8C8C8C;
}
@media (prefers-color-scheme: dark) {
  .card { background: #1F1F24; }
  .title { color: #ECECEC; }
  .range { color: #9DB4CC; }
  .num { color: #8FCFC0; }
  .lb { color: #9DB4CC; }
  .sec { border-top: 1rpx solid #333338; }
  .sec-t { color: #9DB4CC; }
  .name { color: #ECECEC; }
  .v { color: #8FCFC0; }
  .last { color: #9A9A9A; }
}
