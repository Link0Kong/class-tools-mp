<view class="hw-card">
  <view class="hw-hd">
    <text class="hw-ttl">{{title}}</text>
    <text class="hw-cnt" wx:if="{{mode === 'list'}}">共 {{total}} 条</text>
  </view>
  <view class="hw-off" wx:if="{{offline}}">网络不可用 · 以下来自本机缓存</view>

  <block wx:if="{{mode === 'list'}}">
    <view class="hw-row" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bind:tap="onItemTap">
      <view class="hw-rowhd">
        <text class="hw-subj" wx:if="{{item.subject}}">【{{item.subject}}】</text>
        <text class="hw-chip hw-chip-{{item.status}}">{{item.statusText}}</text>
      </view>
      <text class="hw-txt">{{item.content120}}</text>
      <view class="hw-rowft">
        <text class="hw-due">{{item.dueText}}</text>
        <text class="hw-author" wx:if="{{item.author}}">{{item.author}}</text>
      </view>
    </view>
    <view class="hw-empty" wx:if="{{!items.length}}">{{emptyText}}</view>
  </block>

  <block wx:elif="{{mode === 'summary'}}">
    <view class="hw-stats">
      <view class="hw-stat">
        <text class="hw-num">{{stats.pending}}</text>
        <text class="hw-lab">待交</text>
      </view>
      <view class="hw-stat">
        <text class="hw-num hw-num-hot">{{stats.overdue}}</text>
        <text class="hw-lab">已过截止</text>
      </view>
      <view class="hw-stat">
        <text class="hw-num hw-num-mut">{{stats.done}}</text>
        <text class="hw-lab">已完成</text>
      </view>
    </view>
    <view class="hw-next" wx:if="{{stats.next}}">
      <text class="hw-next-lab">最近到期</text>
      <text class="hw-next-t">【{{stats.next.subject}}】{{stats.next.leftText}}</text>
    </view>
    <view class="hw-acts">
      <view class="hw-btn" bind:tap="onListTap">看待交作业</view>
    </view>
  </block>

  <block wx:else>
    <view class="hw-row" wx:if="{{item}}">
      <view class="hw-rowhd">
        <text class="hw-subj" wx:if="{{item.subject}}">【{{item.subject}}】</text>
        <text class="hw-chip hw-chip-{{item.status}}">{{item.statusText}}</text>
      </view>
      <text class="hw-txt">{{item.content}}</text>
      <text class="hw-more" wx:if="{{item.more}}">内容较长，完整内容请在作业板查看</text>
      <text class="hw-meta" wx:if="{{item.dueDateText}}">截止 {{item.dueDateText}}（{{item.dueText}}）</text>
      <text class="hw-meta" wx:if="{{!item.dueDateText}}">{{item.dueText}}</text>
      <view class="hw-atts" wx:if="{{item.attachments.length}}">
        <view class="hw-att" wx:for="{{item.attachments}}" wx:key="name">
          <text class="hw-att-n">{{item.name}}</text>
          <text class="hw-att-s">{{item.sizeText}}</text>
        </view>
      </view>
      <view class="hw-acts">
        <view class="hw-btn" wx:if="{{!item.done}}" data-id="{{item.id}}" bind:tap="onDoneTap">标记已完成</view>
        <view class="hw-btn hw-btn-ghost" wx:if="{{item.done}}" data-id="{{item.id}}" bind:tap="onPendingTap">取消完成</view>
      </view>
    </view>
    <view class="hw-empty" wx:if="{{!item}}">这条作业已不在作业板（可能已被删除或自动清除）</view>
  </block>
</view>
