<view class="nt-card">
  <view class="nt-hd">
    <text class="nt-ttl">{{title}}</text>
    <text class="nt-cnt" wx:if="{{!confirm}}">共 {{total}} 条</text>
  </view>
  <view class="nt-off" wx:if="{{offline}}">网络不可用 · 以下来自本机缓存</view>

  <view class="nt-confirm" wx:if="{{confirm}}">
    <text class="nt-confirm-t">{{title}}</text>
    <text class="nt-confirm-s">{{confirm.text}}</text>
  </view>

  <block wx:if="{{!confirm}}">
    <view class="nt-row" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bind:tap="onItemTap">
      <view class="nt-rowhd">
        <text class="nt-cat">{{item.category}}</text>
        <text class="nt-status {{item.expired ? 'nt-status-exp' : ''}}">{{item.statusText}}</text>
      </view>
      <text class="nt-title">{{item.title}}</text>
      <text class="nt-sum" wx:if="{{item.summary}}">{{item.summary}}</text>
      <view class="nt-rowft">
        <text class="nt-dl" wx:if="{{item.deadlineText}}">截止 {{item.deadlineText}}</text>
        <text class="nt-dl" wx:elif="{{item.eventText}}">{{item.eventText}}</text>
        <text class="nt-dl" wx:else>无时间</text>
        <text class="nt-side">{{item.timeText}}</text>
      </view>
      <view class="nt-tags" wx:if="{{item.images || item.files.length}}">
        <text class="nt-tag" wx:if="{{item.images}}">{{item.images}} 张图片</text>
        <text class="nt-tag" wx:for="{{item.files}}" wx:for-item="f" wx:key="name">{{f.name}} {{f.size}}</text>
      </view>
      <view class="nt-acts">
        <text class="nt-pin" wx:if="{{item.pinned}}">已置顶</text>
        <view class="nt-btn" wx:if="{{!item.done && !item.expired}}" data-id="{{item.id}}" catch:tap="onDoneTap">标记已处理</view>
        <text class="nt-done" wx:if="{{item.done}}">已处理</text>
      </view>
    </view>
    <view class="nt-empty" wx:if="{{!items.length}}">没有符合条件的通知</view>
  </block>
</view>
